        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଫୋନ୍‌ର ଭାଷାରୁ ସ୍ୱତନ୍ତ୍ର ଭାବରେ, ଆପ୍‌ର ଭାଷା ଚୟନ କରନ୍ତୁ।"
