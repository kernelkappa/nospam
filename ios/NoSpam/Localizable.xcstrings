          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αριθμοί που αναφέρθηκαν απευθείας από την κοινότητα του NoSpam (τουλάχιστον 5 αναφορές από διαφορετικούς χρήστες)."
          }
        },
        "en": {
