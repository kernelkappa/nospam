          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die Sprache der App, unabhängig von der deines Telefons."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε τη γλώσσα της εφαρμογής, ανεξάρτητα από αυτή του τηλεφώνου σας."
