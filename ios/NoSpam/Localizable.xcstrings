    "main.smsFilterHint": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لتصفية رسائل SMS غير المرغوب فيها أيضًا، فعِّل NoSpam من الإعدادات > الرسائل > الرسائل غير المعروفة والمزعجة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্প্যাম SMS ফিল্টার করতেও, সেটিংস > মেসেজ > অজানা ও স্প্যাম থেকে NoSpam সক্রিয় করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per filtrar també els SMS brossa, activa NoSpam des de Configuració > Missatges > Desconeguts i brossa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li filtrovat i spamové SMS, povolte NoSpam v Nastavení > Zprávy > Neznámé a spam."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For også at filtrere spam-sms'er, aktivér NoSpam fra Indstillinger > Beskeder > Ukendt og spam."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um auch Spam-SMS zu filtern, aktiviere NoSpam unter Einstellungen > Nachrichten > Unbekannt & Spam filtern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για να φιλτράρετε και τα ανεπιθύμητα SMS, ενεργοποιήστε το NoSpam από Ρυθμίσεις > Μηνύματα > Άγνωστα & ανεπιθύμητα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To also filter spam SMS, enable NoSpam from Settings > Messages > Unknown & Spam."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para filtrar también los SMS spam, activa NoSpam desde Ajustes > Mensajes > Filtrado de SMS desconocidos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suodattaaksesi myös roskapostiviestit, ota NoSpam käyttöön kohdassa Asetukset > Viestit > Tuntemattomat ja roskaposti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour filtrer aussi les SMS indésirables, activez NoSpam depuis Réglages > Messages > Filtrage des SMS inconnus."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સ્પામ SMS ને પણ ફિલ્ટર કરવા માટે, સેટિંગ્સ > મેસેજ > અજાણ્યા અને સ્પામ માંથી NoSpam સક્રિય કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי לסנן גם הודעות SMS של זבל, הפעל את NoSpam מתוך הגדרות > הודעות > לא ידוע וזבל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्पैम SMS को भी फ़िल्टर करने के लिए, सेटिंग्स > मैसेज > अज्ञात और स्पैम से NoSpam सक्षम करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za filtriranje neželjenih SMS poruka omogućite NoSpam u Postavke > Poruke > Nepoznato i neželjeno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A spam SMS-ek szűréséhez is engedélyezze a NoSpam-et a Beállítások > Üzenetek > Ismeretlen és spam menüben."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk juga memfilter SMS spam, aktifkan NoSpam dari Pengaturan > Pesan > Tidak dikenal & Spam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per filtrare anche gli SMS spam, abilita NoSpam da Impostazioni > Messaggi > Filtraggio SMS sconosciuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スパムSMSもフィルタリングするには、設定 > メッセージ > 不明な送信者と迷惑メッセージからNoSpamを有効にしてください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಪ್ಯಾಮ್ SMS ಅನ್ನು ಸಹ ಫಿಲ್ಟರ್ ಮಾಡಲು, ಸೆಟ್ಟಿಂಗ್‌ಗಳು > ಮೆಸೇಜ್‌ಗಳು > ಅಜ್ಞಾತ ಮತ್ತು ಸ್ಪ್ಯಾಮ್‌ನಿಂದ NoSpam ಅನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스팸 SMS도 필터링하려면 설정 > 메시지 > 알 수 없음 및 스팸에서 NoSpam을 활성화하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്പാം SMS കൂടി ഫിൽട്ടർ ചെയ്യാൻ, ക്രമീകരണങ്ങൾ > മെസേജുകൾ > അജ്ഞാതവും സ്പാമും എന്നതിൽ നിന്ന് NoSpam പ്രവർത്തനക്ഷമമാക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्पॅम SMS देखील फिल्टर करण्यासाठी, सेटिंग्ज > मेसेज > अज्ञात आणि स्पॅम मधून NoSpam सक्षम करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menapis SMS spam juga, dayakan NoSpam daripada Tetapan > Mesej > Tidak dikenali & Spam."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For å også filtrere spam-SMS, aktiver NoSpam fra Innstillinger > Meldinger > Ukjent og spam."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om ook spam-sms'jes te filteren, schakel NoSpam in via Instellingen > Berichten > Onbekend & spam."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସ୍ପାମ୍ SMS ମଧ୍ୟ ଫିଲ୍ଟର କରିବାକୁ, ସେଟିଂସ୍‌ > ମେସେଜ୍ > ଅଜ୍ଞାତ ଏବଂ ସ୍ପାମ୍‌ରୁ NoSpam ସକ୍ଷମ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਪੈਮ SMS ਨੂੰ ਵੀ ਫਿਲਟਰ ਕਰਨ ਲਈ, ਸੈਟਿੰਗਾਂ > ਮੈਸੇਜ > ਅਣਜਾਣ ਅਤੇ ਸਪੈਮ ਤੋਂ NoSpam ਨੂੰ ਸਮਰੱਥ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby filtrować również spamowe SMS-y, włącz NoSpam w Ustawienia > Wiadomości > Nieznane i spam."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para filtrar também SMS spam, ative o NoSpam em Definições > Mensagens > Filtragem de SMS desconhecidos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para filtrar também SMS de spam, ative o NoSpam em Configurações > Mensagens > Desconhecido e Spam."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a filtra și SMS-urile spam, activează NoSpam din Setări > Mesaje > Necunoscut și spam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы также фильтровать спам-SMS, включите NoSpam в разделе Настройки > Сообщения > Неизвестные и спам."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete filtrovať aj spamové SMS, povoľte NoSpam v Nastavenia > Správy > Neznáme a spam."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za filtriranje tudi vsiljenih SMS-ov omogočite NoSpam v Nastavitve > Sporočila > Neznano in vsiljeno."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att också filtrera skräp-SMS, aktivera NoSpam från Inställningar > Meddelanden > Okänt och skräppost."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஸ்பாம் SMS-ஐயும் வடிகட்ட, அமைப்புகள் > செய்திகள் > அறியப்படாதவை & ஸ்பாம் இலிருந்து NoSpam-ஐ இயக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్పామ్ SMSలను కూడా ఫిల్టర్ చేయడానికి, సెట్టింగ్‌లు > మెసేజీలు > తెలియనివి & స్పామ్ నుండి NoSpamను ప్రారంభించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพื่อกรองสแปม SMS ด้วย ให้เปิดใช้งาน NoSpam จากการตั้งค่า > ข้อความ > ไม่รู้จักและสแปม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spam SMS'leri de filtrelemek için NoSpam'i Ayarlar > Mesajlar > Bilinmeyen ve Spam bölümünden etkinleştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб також фільтрувати спам-SMS, увімкніть NoSpam у Налаштування > Повідомлення > Невідомі та спам."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسپیم SMS کو بھی فلٹر کرنے کے لیے، سیٹنگز > پیغامات > نامعلوم اور اسپیم سے NoSpam کو فعال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để lọc cả SMS spam, hãy bật NoSpam từ Cài đặt > Tin nhắn > Không xác định & Spam."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要同时过滤垃圾短信，请在设置 > 信息 > 未知号码与垃圾信息中启用 NoSpam。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若要同時過濾垃圾簡訊，請從設定 > 訊息 > 不明與垃圾訊息中啟用 NoSpam。"
          }
        }
      }
    },
    "main.staleHint": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قاعدة بيانات السبام لم تُحدَّث منذ فترة: حدّثها يدويًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্প্যাম ডেটাবেস কিছুক্ষণ ধরে আপডেট হয়নি: এটি ম্যানুয়ালি আপডেট করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La base de dades de spam no s'ha actualitzat des de fa temps: actualitza-la manualment."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Databáze spamu se už nějakou dobu neaktualizovala: aktualizujte ji manuálně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spam-databasen er ikke blevet opdateret i et stykke tid: opdater den manuelt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Spam-Datenbank wurde seit einiger Zeit nicht aktualisiert: Aktualisiere sie manuell."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η βάση δεδομένων ανεπιθύμητων κλήσεων δεν έχει ενημερωθεί εδώ και καιρό: ενημερώστε την χειροκίνητα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The spam database hasn't updated in a while: update it manually."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La base de datos de spam no se actualiza desde hace un tiempo: actualízala manualmente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Roskapuhelutietokantaa ei ole päivitetty viime aikoina: päivitä se manuaalisesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La base de données spam n'a pas été mise à jour depuis un moment : mettez-la à jour manuellement."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સ્પામ ડેટાબેઝ થોડા સમયથી અપડેટ થયો નથી: તેને મેન્યુઅલી અપડેટ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסד נתוני הספאם לא התעדכן כבר זמן מה: עדכן אותו באופן ידני."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्पैम डेटाबेस कुछ समय से अपडेट नहीं हुआ है: इसे मैन्युअल रूप से अपडेट करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Baza podataka o neželjenim pozivima nije ažurirana neko vrijeme: ažurirajte je ručno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A spam adatbázis egy ideje nem frissült: frissítsd manuálisan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Database spam belum diperbarui dalam beberapa waktu: perbarui secara manual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il database spam non si aggiorna da un po': aggiornalo manualmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スパムデータベースがしばらく更新されていません。手動で更新してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಪ್ಯಾಮ್ ಡೇಟಾಬೇಸ್ ಸ್ವಲ್ಪ ಸಮಯದಿಂದ ನವೀಕರಣಗೊಂಡಿಲ್ಲ: ಅದನ್ನು ಹಸ್ತಚಾಲಿತವಾಗಿ ನವೀಕರಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스팸 데이터베이스가 한동안 업데이트되지 않았습니다. 수동으로 업데이트하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്പാം ഡാറ്റാബേസ് കുറച്ചുകാലമായി അപ്‌ഡേറ്റ് ചെയ്തിട്ടില്ല: ഇത് സ്വമേധയാ അപ്‌ഡേറ്റ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्पॅम डेटाबेस काही वेळापासून अपडेट झालेला नाही: तो मॅन्युअली अपडेट करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pangkalan data spam tidak dikemas kini sejak beberapa waktu: kemas kini secara manual."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spam-databasen har ikke blitt oppdatert på en stund: oppdater den manuelt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De spamdatabase is al een tijdje niet bijgewerkt: werk deze handmatig bij."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସ୍ପାମ ଡାଟାବେସ୍ କିଛି ସମୟ ହେଲା ଅପଡେଟ୍ ହୋଇନାହିଁ: ଏହାକୁ ମାନୁଆଲ ଭାବରେ ଅପଡେଟ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਪੈਮ ਡੇਟਾਬੇਸ ਕੁਝ ਸਮੇਂ ਤੋਂ ਅੱਪਡੇਟ ਨਹੀਂ ਹੋਇਆ: ਇਸਨੂੰ ਖੁਦ ਅੱਪਡੇਟ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Baza danych spamu nie była aktualizowana od pewnego czasu: zaktualizuj ją ręcznie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A base de dados de spam não é atualizada há algum tempo: atualize-a manualmente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O banco de dados de spam não é atualizado há um tempo: atualize-o manualmente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Baza de date de spam nu a fost actualizată de o vreme: actualizeaz-o manual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "База данных спама давно не обновлялась: обновите её вручную."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Databáza spamu sa už chvíľu neaktualizovala: aktualizujte ju manuálne."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podatkovna baza neželenih klicev se že nekaj časa ni posodobila: posodobite jo ročno."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spam-databasen har inte uppdaterats på ett tag: uppdatera den manuellt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஸ்பாம் தரவுத்தளம் சிறிது நேரமாக புதுப்பிக்கப்படவில்லை: அதை கைமுறையாக புதுப்பிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్పామ్ డేటాబేస్ కొంత సమయంగా అప్‌డేట్ కాలేదు: దానిని మాన్యువల్‌గా అప్‌డేట్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฐานข้อมูลสแปมไม่ได้รับการอัปเดตมาสักระยะแล้ว: โปรดอัปเดตด้วยตนเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spam veritabanı bir süredir güncellenmedi: elle güncelleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Базу даних спаму давно не оновлювали: оновіть її вручну."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسپیم ڈیٹا بیس کچھ عرصے سے اپڈیٹ نہیں ہوا: اسے دستی طور پر اپڈیٹ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cơ sở dữ liệu spam đã lâu chưa được cập nhật: hãy cập nhật thủ công."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "垃圾号码数据库已有一段时间未更新：请手动更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "垃圾號碼資料庫已有一段時間未更新：請手動更新。"
          }
        }
      }
