        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଡାଟାବେସ୍ ଅପଡେଟ୍ ହୋଇଛି। ବ୍ଲକିଂ ସକ୍ଷମ କରିବାକୁ, ଉପରେ «ସେଟିଂସ୍‌ ଖୋଲନ୍ତୁ» ଟାପ୍ କରନ୍ତୁ ଏବଂ ଗାଇଡ୍ ଅନୁସରଣ କରନ୍ତୁ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Baza danych zaktualizowana. Aby włączyć blokowanie, dotknij “Otwórz Ustawienia” powyżej i postępuj zgodnie z instrukcją."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਡੇਟਾਬੇਸ ਅੱਪਡੇਟ ਹੋ ਗਿਆ। ਬਲਾਕਿੰਗ ਸਮਰੱਥ ਕਰਨ ਲਈ, ਉੱਪਰ «ਸੈਟਿੰਗਾਂ ਖੋਲ੍ਹੋ» ਟੈਪ ਕਰੋ ਅਤੇ ਗਾਈਡ ਦਾ ਪਾਲਣ ਕਰੋ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Banco de dados atualizado. Para ativar o bloqueio, toque em “Abrir Configurações” acima e siga o guia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Baza de date a fost actualizată. Pentru a activa blocarea, apasă pe „Deschide Setările” mai sus și urmează ghidul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "База данных обновлена. Чтобы включить блокировку, нажмите «Открыть настройки» выше и следуйте инструкции."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Databáza bola aktualizovaná. Ak chcete aktivovať blokovanie, klepnite vyššie na „Otvoriť Nastavenia“ a postupujte podľa návodu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podatkovna baza je posodobljena. Za omogočitev blokiranja se dotaknite zgoraj »Odpri Nastavitve« in sledite navodilom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Databasen har uppdaterats. För att aktivera blockering, tryck på “Öppna Inställningar” ovan och följ guiden."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தரவுத்தளம் புதுப்பிக்கப்பட்டது. தடுப்பை இயக்க, மேலே «அமைப்புகளைத் திறக்கவும்» என்பதைத் தட்டி வழிகாட்டியைப் பின்பற்றவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "డేటాబేస్ అప్‌డేట్ చేయబడింది. బ్లాకింగ్‌ను ప్రారంభించడానికి, పైన «సెట్టింగ్‌లను తెరవండి» నొక్కి గైడ్‌ను అనుసరించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัปเดตฐานข้อมูลแล้ว เพื่อเปิดใช้งานการบล็อก แตะ “เปิดการตั้งค่า” ด้านบนและทำตามคำแนะนำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veritabanı güncellendi. Engellemeyi etkinleştirmek için yukarıdaki “Ayarları Aç”a dokunun ve kılavuzu takip edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Базу даних оновлено. Щоб увімкнути блокування, торкніться «Відкрити налаштування» вище і дотримуйтесь інструкції."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ڈیٹا بیس اپڈیٹ ہو گیا۔ بلاکنگ فعال کرنے کے لیے، اوپر «سیٹنگز کھولیں» پر ٹیپ کریں اور گائیڈ کی پیروی کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cơ sở dữ liệu đã được cập nhật. Để bật chặn, hãy chạm vào “Mở Cài đặt” ở trên và làm theo hướng dẫn."
          }
        }
      }
    },
