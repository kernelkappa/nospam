    "update.message": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتوفر إصدار جديد من NoSpam يحتوي على إصلاحات مهمة. قم بالتحديث لمواصلة استخدام التطبيق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গুরুত্বপূর্ণ সংশোধন সহ NoSpam-এর একটি নতুন সংস্করণ উপলব্ধ। অ্যাপ ব্যবহার চালিয়ে যেতে আপডেট করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi ha disponible una nova versió de NoSpam amb correccions importants. Actualitza per continuar utilitzant l\\'app."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je k dispozici nová verze NoSpam s důležitými opravami. Aktualizujte a pokračujte v používání aplikace."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er en ny version af NoSpam med vigtige rettelser. Opdater for at fortsætte med at bruge appen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine neue Version von NoSpam mit wichtigen Korrekturen ist verfügbar. Aktualisiere die App, um sie weiterhin nutzen zu können."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είναι διαθέσιμη μια νέα έκδοση του NoSpam με σημαντικές διορθώσεις. Ενημερώστε για να συνεχίσετε να χρησιμοποιείτε την εφαρμογή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new version of NoSpam with important fixes is available. Update to keep using the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay disponible una nueva versión de NoSpam con correcciones importantes. Actualiza para seguir usando la app."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "NoSpamista on saatavilla uusi versio, joka sisältää tärkeitä korjauksia. Päivitä jatkaaksesi sovelluksen käyttöä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une nouvelle version de NoSpam avec des corrections importantes est disponible. Mettez à jour pour continuer à utiliser l'application."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મહત્વપૂર્ણ સુધારાઓ સાથે NoSpam નું નવું વર્ઝન ઉપલબ્ધ છે. એપનો ઉપયોગ ચાલુ રાખવા માટે અપડેટ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גרסה חדשה של NoSpam עם תיקונים חשובים זמינה. עדכן כדי להמשיך להשתמש באפליקציה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "महत्वपूर्ण सुधारों के साथ NoSpam का नया संस्करण उपलब्ध है। ऐप का उपयोग जारी रखने के लिए अपडेट करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostupna je nova verzija NoSpam-a s važnim ispravcima. Ažurirajte za nastavak korištenja aplikacije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A NoSpam új, fontos javításokat tartalmazó verziója elérhető. Frissítsen az alkalmazás további használatához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi baru NoSpam dengan perbaikan penting tersedia. Perbarui untuk terus menggunakan aplikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È disponibile una nuova versione di NoSpam con correzioni importanti. Aggiorna per continuare a usare l'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重要な修正を含むNoSpamの新しいバージョンが利用可能です。アプリを使い続けるには更新してください。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರಮುಖ ಸುಧಾರಣೆಗಳೊಂದಿಗೆ NoSpam ನ ಹೊಸ ಆವೃತ್ತಿ ಲಭ್ಯವಿದೆ. ಅಪ್ಲಿಕೇಶನ್ ಬಳಸುವುದನ್ನು ಮುಂದುವರಿಸಲು ಅಪ್‌ಡೇಟ್ ಮಾಡಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중요한 수정 사항이 포함된 NoSpam의 새 버전을 사용할 수 있습니다. 앱을 계속 사용하려면 업데이트하세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പ്രധാന പരിഹാരങ്ങളുള്ള NoSpam-ന്റെ പുതിയ പതിപ്പ് ലഭ്യമാണ്. ആപ്പ് ഉപയോഗിക്കുന്നത് തുടരാൻ അപ്ഡേറ്റ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "महत्त्वाच्या सुधारणांसह NoSpam ची नवीन आवृत्ती उपलब्ध आहे. अ‍ॅप वापरणे सुरू ठेवण्यासाठी अपडेट करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi baharu NoSpam dengan pembetulan penting tersedia. Kemas kini untuk terus menggunakan aplikasi ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En ny versjon av NoSpam med viktige forbedringer er tilgjengelig. Oppdater for å fortsette å bruke appen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is een nieuwe versie van NoSpam beschikbaar met belangrijke verbeteringen. Werk bij om de app te blijven gebruiken."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ମହତ୍ତ୍ୱପୂର୍ଣ୍ଣ ସୁଧାର ସହିତ NoSpam ର ନୂତନ ସଂସ୍କରଣ ଉପଲବ୍ଧ। ଆପ୍ ବ୍ୟବହାର ଜାରି ରଖିବାକୁ ଅପଡେଟ୍ କରନ୍ତୁ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮਹੱਤਵਪੂਰਨ ਸੁਧਾਰਾਂ ਦੇ ਨਾਲ NoSpam ਦਾ ਨਵਾਂ ਵਰਜਨ ਉਪਲਬਧ ਹੈ। ਐਪ ਦੀ ਵਰਤੋਂ ਜਾਰੀ ਰੱਖਣ ਲਈ ਅੱਪਡੇਟ ਕਰੋ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostępna jest nowa wersja NoSpam z ważnymi poprawkami. Zaktualizuj, aby nadal korzystać z aplikacji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Está disponível uma nova versão do NoSpam com correções importantes. Atualize para continuar a usar a app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma nova versão do NoSpam com correções importantes está disponível. Atualize para continuar usando o app."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Este disponibilă o nouă versiune de NoSpam cu remedieri importante. Actualizați pentru a continua să utilizați aplicația."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступна новая версия NoSpam с важными исправлениями. Обновите приложение, чтобы продолжить его использование."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "K dispozícii je nová verzia NoSpam s dôležitými opravami. Aktualizujte a pokračujte v používaní aplikácie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na voljo je nova različica NoSpam s pomembnimi popravki. Posodobite, da boste lahko še naprej uporabljali aplikacijo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En ny version av NoSpam med viktiga korrigeringar är tillgänglig. Uppdatera för att fortsätta använda appen."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முக்கியமான சரிசெய்தல்களுடன் NoSpam இன் புதிய பதிப்பு கிடைக்கிறது. பயன்பாட்டைத் தொடர்ந்து பயன்படுத்த புதுப்பிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ముఖ్యమైన సవరణలతో NoSpam యొక్క కొత్త వెర్షన్ అందుబాటులో ఉంది. యాప్‌ను ఉపయోగించడం కొనసాగించడానికి అప్‌డేట్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มี NoSpam เวอร์ชันใหม่พร้อมการแก้ไขที่สำคัญ อัปเดตเพื่อใช้แอปต่อไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önemli düzeltmeler içeren yeni bir NoSpam sürümü mevcut. Uygulamayı kullanmaya devam etmek için güncelleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступна нова версія NoSpam з важливими виправленнями. Оновіть, щоб продовжити використання програми."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اہم اصلاحات کے ساتھ NoSpam کا نیا ورژن دستیاب ہے۔ ایپ کا استعمال جاری رکھنے کے لیے اپڈیٹ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã có phiên bản mới của NoSpam với các bản vá quan trọng. Cập nhật để tiếp tục sử dụng ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "NoSpam 有重要修复的新版本可用。请更新以继续使用本应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "NoSpam 有包含重要修正的新版本可用。請更新以繼續使用此應用程式。"
          }
        }
      }
    },
