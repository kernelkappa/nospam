          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डेटाबेस अपडेट हो गया। ब्लॉकिंग सक्षम करने के लिए, ऊपर «सेटिंग्स खोलें» टैप करें और गाइड का पालन करें।"
