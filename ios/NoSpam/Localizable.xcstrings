    "status.callBlockingDisabled": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocco chiamate disattivato. Tocca «Apri Impostazioni» qui sotto: ti guidiamo passo passo per attivarlo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call blocking disabled. Tap «Open Settings» below: we'll guide you step by step to enable it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueo de llamadas desactivado. Toca «Abrir Ajustes» abajo: te guiamos paso a paso para activarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocage des appels désactivé. Appuyez sur « Ouvrir les réglages » ci-dessous : nous vous guidons étape par étape pour l'activer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anrufblockierung deaktiviert. Tippe unten auf „Einstellungen öffnen“: Wir führen dich Schritt für Schritt durch die Aktivierung."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueio de chamadas desativado. Toque em «Abrir Definições» abaixo: nós guiamo-lo passo a passo para o ativar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حظر المكالمات معطّل. اضغط على «فتح الإعدادات» أدناه: سنوجهك خطوة بخطوة لتفعيله."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কল ব্লকিং নিষ্ক্রিয়। নীচে «সেটিংস খুলুন» ট্যাপ করুন: আমরা ধাপে ধাপে এটি সক্রিয় করতে গাইড করব।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueig de trucades desactivat. Toca «Obre Configuració» a sota: et guiarem pas a pas per activar-lo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来电拦截已停用。点按下方的“打开设置”：我们会一步步引导你启用该功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來電封鎖已停用。點一下下方的「打開設定」：我們會逐步引導你啟用此功能。"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokiranje poziva deaktivirano. Dotaknite “Otvori postavke” ispod: vodit ćemo vas korak po korak kako biste to omogućili."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokování hovorů je deaktivováno. Klepněte níže na „Otevřít Nastavení“: krok za krokem vás provedeme aktivací."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opkaldsblokering deaktiveret. Tryk på “Åbn Indstillinger” nedenfor: vi guider dig trin for trin for at aktivere den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oproepblokkering uitgeschakeld. Tik hieronder op “Open Instellingen”: we begeleiden je stap voor stap om het in te schakelen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhelunesto pois käytöstä. Napauta alla “Avaa Asetukset”: opastamme sinua vaihe vaiheelta sen käyttöönotossa."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο αποκλεισμός κλήσεων είναι απενεργοποιημένος. Πατήστε «Άνοιγμα Ρυθμίσεων» παρακάτω: θα σας καθοδηγήσουμε βήμα προς βήμα για να το ενεργοποιήσετε."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કૉલ બ્લોકિંગ નિષ્ક્રિય છે. નીચે «સેટિંગ્સ ખોલો» ટૅપ કરો: અમે તેને સક્રિય કરવા માટે તમને પગલું-દર-પગલું માર્ગદર્શન આપીશું."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חסימת שיחות מושבתת. הקש על «פתח הגדרות» למטה: נדריך אותך שלב אחר שלב להפעלתו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉल ब्लॉकिंग अक्षम है। नीचे «सेटिंग्स खोलें» टैप करें: हम इसे सक्षम करने के लिए आपको चरण-दर-चरण मार्गदर्शन देंगे।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hívásblokkolás letiltva. Koppintson alul a „Beállítások megnyitása” gombra: lépésről lépésre végigvezetjük az engedélyezésen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemblokiran panggilan dinonaktifkan. Ketuk “Buka Pengaturan” di bawah: kami akan memandu Anda langkah demi langkah untuk mengaktifkannya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "着信ブロックが無効です。下の「設定を開く」をタップしてください。有効にする手順をご案内します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕರೆ ನಿರ್ಬಂಧ ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಲಾಗಿದೆ. ಕೆಳಗೆ «ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ತೆರೆಯಿರಿ» ಅನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ: ಅದನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಲು ನಾವು ನಿಮಗೆ ಹಂತ ಹಂತವಾಗಿ ಮಾರ್ಗದರ್ಶನ ನೀಡುತ್ತೇವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전화 차단이 비활성화되었습니다. 아래의 \"설정 열기\"를 탭하세요. 활성화 방법을 단계별로 안내해 드립니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekatan panggilan dilumpuhkan. Ketik “Buka Tetapan” di bawah: kami akan membimbing anda langkah demi langkah untuk mengaktifkannya."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കോൾ ബ്ലോക്കിംഗ് പ്രവർത്തനരഹിതമാണ്. താഴെ «ക്രമീകരണങ്ങൾ തുറക്കുക» ടാപ്പ് ചെയ്യുക: ഇത് പ്രവർത്തനക്ഷമമാക്കാൻ ഞങ്ങൾ നിങ്ങളെ ഘട്ടം ഘട്ടമായി സഹായിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉल ब्लॉकिंग निष्क्रिय आहे. खाली «सेटिंग्ज उघडा» टॅप करा: ते सक्षम करण्यासाठी आम्ही तुम्हाला टप्प्याटप्प्याने मार्गदर्शन करू."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Anropsblokkering er deaktivert. Trykk på “Åpne Innstillinger” nedenfor: vi veileder deg trinn for trinn for å aktivere den."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କଲ୍ ବ୍ଲକିଂ ନିଷ୍କ୍ରିୟ ଅଛି। ତଳେ «ସେଟିଂସ୍‌ ଖୋଲନ୍ତୁ» ଟାପ୍ କରନ୍ତୁ: ଏହାକୁ ସକ୍ଷମ କରିବା ପାଇଁ ଆମେ ଆପଣଙ୍କୁ ପର୍ଯ୍ୟାୟକ୍ରମେ ମାର୍ଗଦର୍ଶନ କରିବୁ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokowanie połączeń wyłączone. Dotknij “Otwórz Ustawienia” poniżej: przeprowadzimy Cię krok po kroku, aby je włączyć."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਾਲ ਬਲਾਕਿੰਗ ਅਸਮਰੱਥ ਹੈ। ਹੇਠਾਂ «ਸੈਟਿੰਗਾਂ ਖੋਲ੍ਹੋ» ਟੈਪ ਕਰੋ: ਇਸਨੂੰ ਸਮਰੱਥ ਕਰਨ ਲਈ ਅਸੀਂ ਤੁਹਾਨੂੰ ਕਦਮ-ਦਰ-ਕਦਮ ਮਾਰਗਦਰਸ਼ਨ ਦੇਵਾਂਗੇ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueio de chamadas desativado. Toque em “Abrir Configurações” abaixo: vamos guiá-lo passo a passo para ativá-lo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocarea apelurilor este dezactivată. Apasă pe „Deschide Setările” mai jos: te vom ghida pas cu pas pentru a-l activa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокировка звонков отключена. Нажмите «Открыть настройки» ниже: мы шаг за шагом поможем вам включить эту функцию."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokovanie hovorov je deaktivované. Klepnite nižšie na „Otvoriť Nastavenia“: krok za krokom vás prevedieme aktiváciou."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokiranje klicev je onemogočeno. Dotaknite se spodaj »Odpri Nastavitve«: vodili vas bomo korak za korakom, da jo omogočite."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Samtalsblockering inaktiverad. Tryck på “Öppna Inställningar” nedan: vi guidar dig steg för steg för att aktivera den."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அழைப்பு தடுப்பு முடக்கப்பட்டுள்ளது. கீழே «அமைப்புகளைத் திறக்கவும்» என்பதைத் தட்டவும்: அதை இயக்க நாங்கள் உங்களுக்கு படிப்படியாக வழிகாட்டுவோம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కాల్ బ్లాకింగ్ నిలిపివేయబడింది. దిగువన «సెట్టింగ్‌లను తెరవండి» నొక్కండి: దీన్ని ప్రారంభించడానికి మేము మీకు దశల వారీగా మార్గనిర్దేశం చేస్తాము."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบล็อกสายถูกปิดใช้งาน แตะ “เปิดการตั้งค่า” ด้านล่าง: เราจะแนะนำคุณทีละขั้นตอนเพื่อเปิดใช้งาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çağrı engelleme devre dışı. Aşağıdaki “Ayarları Aç”a dokunun: etkinleştirmek için size adım adım yol göstereceğiz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокування викликів вимкнено. Торкніться «Відкрити налаштування» нижче: ми крок за кроком допоможемо вам увімкнути цю функцію."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کال بلاکنگ غیر فعال ہے۔ نیچے «سیٹنگز کھولیں» پر ٹیپ کریں: ہم اسے فعال کرنے کے لیے آپ کو مرحلہ وار رہنمائی فراہم کریں گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chặn cuộc gọi đã bị tắt. Chạm vào “Mở Cài đặt” bên dưới: chúng tôi sẽ hướng dẫn bạn từng bước để bật tính năng này."
          }
        }
      }
    },
