        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொலைபேசியின் மொழியைப் பொருட்படுத்தாமல், பயன்பாட்டின் மொழியைத் தேர்ந்தெடுக்கவும்."
          }
