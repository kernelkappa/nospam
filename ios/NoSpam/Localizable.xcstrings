          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Números señalados directamente por la comunidad de NoSpam (al menos 5 denuncias de usuarios distintos)."
          }
        },
        "fi": {
          "stringUnit": {
