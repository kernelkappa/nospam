    "error.extensionDisabled": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca «Apri Impostazioni» nella schermata principale: ti guidiamo passo passo per attivarlo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap «Open Settings» on the main screen: we'll guide you step by step to enable it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca «Abrir Ajustes» en la pantalla principal: te guiamos paso a paso para activarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur « Ouvrir les réglages » sur l'écran principal : nous vous guidons étape par étape pour l'activer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf der Hauptseite auf „Einstellungen öffnen“: Wir führen dich Schritt für Schritt durch die Aktivierung."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em «Abrir Definições» no ecrã principal: nós guiamo-lo passo a passo para o ativar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على «فتح الإعدادات» في الشاشة الرئيسية: سنوجهك خطوة بخطوة لتفعيله."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মূল স্ক্রিনে «সেটিংস খুলুন» ট্যাপ করুন: আমরা ধাপে ধাপে এটি সক্রিয় করতে গাইড করব।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca «Obre Configuració» a la pantalla principal: et guiarem pas a pas per activar-lo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在主屏幕上点按“打开设置”：我们会一步步引导你启用该功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在主畫面點一下「打開設定」：我們會逐步引導你啟用此功能。"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotaknite “Otvori postavke” na glavnom zaslonu: vodit ćemo vas korak po korak kako biste to omogućili."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepněte na „Otevřít Nastavení“ na hlavní obrazovce: krok za krokem vás provedeme aktivací."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på “Åbn Indstillinger” på hovedskærmen: vi guider dig trin for trin for at aktivere den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op “Open Instellingen” op het hoofdscherm: we begeleiden je stap voor stap om het in te schakelen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta “Avaa Asetukset” päänäytöllä: opastamme sinua vaihe vaiheelta sen käyttöönotossa."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε «Άνοιγμα Ρυθμίσεων» στην κύρια οθόνη: θα σας καθοδηγήσουμε βήμα προς βήμα για να το ενεργοποιήσετε."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મુખ્ય સ્ક્રીન પર «સેટિંગ્સ ખોલો» ટૅપ કરો: અમે તેને સક્રિય કરવા માટે તમને પગલું-દર-પગલું માર્ગદર્શન આપીશું."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש על «פתח הגדרות» במסך הראשי: נדריך אותך שלב אחר שלב להפעלתו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुख्य स्क्रीन पर «सेटिंग्स खोलें» टैप करें: हम इसे सक्षम करने के लिए आपको चरण-दर-चरण मार्गदर्शन देंगे।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppintson a főképernyőn a „Beállítások megnyitása” gombra: lépésről lépésre végigvezetjük az engedélyezésen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk “Buka Pengaturan” di layar utama: kami akan memandu Anda langkah demi langkah untuk mengaktifkannya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メイン画面で「設定を開く」をタップしてください。有効にする手順をご案内します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮುಖ್ಯ ಪರದೆಯಲ್ಲಿ «ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ತೆರೆಯಿರಿ» ಅನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ: ಅದನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಲು ನಾವು ನಿಮಗೆ ಹಂತ ಹಂತವಾಗಿ ಮಾರ್ಗದರ್ಶನ ನೀಡುತ್ತೇವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메인 화면에서 \"설정 열기\"를 탭하세요. 활성화 방법을 단계별로 안내해 드립니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik “Buka Tetapan” pada skrin utama: kami akan membimbing anda langkah demi langkah untuk mengaktifkannya."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പ്രധാന സ്ക്രീനിൽ «ക്രമീകരണങ്ങൾ തുറക്കുക» ടാപ്പ് ചെയ്യുക: ഇത് പ്രവർത്തനക്ഷമമാക്കാൻ ഞങ്ങൾ നിങ്ങളെ ഘട്ടം ഘട്ടമായി സഹായിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मुख्य स्क्रीनवर «सेटिंग्ज उघडा» टॅप करा: ते सक्षम करण्यासाठी आम्ही तुम्हाला टप्प्याटप्प्याने मार्गदर्शन करू."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på “Åpne Innstillinger” på hovedskjermen: vi veileder deg trinn for trinn for å aktivere den."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ମୁଖ୍ୟ ସ୍କ୍ରିନ୍‌ରେ «ସେଟିଂସ୍‌ ଖୋଲନ୍ତୁ» ଟାପ୍ କରନ୍ତୁ: ଏହାକୁ ସକ୍ଷମ କରିବା ପାଇଁ ଆମେ ଆପଣଙ୍କୁ ପର୍ଯ୍ୟାୟକ୍ରମେ ମାର୍ଗଦର୍ଶନ କରିବୁ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij “Otwórz Ustawienia” na głównym ekranie: przeprowadzimy Cię krok po kroku, aby je włączyć."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮੁੱਖ ਸਕ੍ਰੀਨ 'ਤੇ «ਸੈਟਿੰਗਾਂ ਖੋਲ੍ਹੋ» ਟੈਪ ਕਰੋ: ਇਸਨੂੰ ਸਮਰੱਥ ਕਰਨ ਲਈ ਅਸੀਂ ਤੁਹਾਨੂੰ ਕਦਮ-ਦਰ-ਕਦਮ ਮਾਰਗਦਰਸ਼ਨ ਦੇਵਾਂਗੇ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em “Abrir Configurações” na tela principal: vamos guiá-lo passo a passo para ativá-lo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apasă pe „Deschide Setările” pe ecranul principal: te vom ghida pas cu pas pentru a-l activa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите «Открыть настройки» на главном экране: мы шаг за шагом поможем вам включить эту функцию."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnite na „Otvoriť Nastavenia“ na hlavnej obrazovke: krok za krokom vás prevedieme aktiváciou."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotaknite se »Odpri Nastavitve« na glavnem zaslonu: vodili vas bomo korak za korakom, da jo omogočite."
