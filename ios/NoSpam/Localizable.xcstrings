        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahtjev je trajao previše dugo: pokušajte ponovno kasnije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kérés túl sokáig tartott: próbálja újra később."
