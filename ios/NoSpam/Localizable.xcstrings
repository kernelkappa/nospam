    "error.extensionDisabled" : {
      "localizations" : {
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Tocca «Apri Impostazioni» nella schermata principale: ti guidiamo passo passo per attivarlo." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Tap «Open Settings» on the main screen: we'll guide you step by step to enable it." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Toca «Abrir Ajustes» en la pantalla principal: te guiamos paso a paso para activarlo." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Appuyez sur « Ouvrir les réglages » sur l'écran principal : nous vous guidons étape par étape pour l'activer." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Tippe auf der Hauptseite auf „Einstellungen öffnen“: Wir führen dich Schritt für Schritt durch die Aktivierung." } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "Toque em «Abrir Definições» no ecrã principal: nós guiamo-lo passo a passo para o ativar." } }
