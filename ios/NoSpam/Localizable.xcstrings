    "credits.source.blocklistIt.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قائمة مفتوحة يحافظ عليها المجتمع، من إعداد thesqual87 / Kallm."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কমিউনিটি দ্বারা পরিচালিত উন্মুক্ত তালিকা, কিউরেট করেছেন thesqual87 / Kallm।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Llista oberta mantinguda per la comunitat, a cura de thesqual87 / Kallm."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřený seznam udržovaný komunitou, kurátoři thesqual87 / Kallm."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åben liste vedligeholdt af fællesskabet, kurateret af thesqual87 / Kallm."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Offene, von der Community gepflegte Liste, kuratiert von thesqual87 / Kallm."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοιχτή λίστα που συντηρείται από την κοινότητα, επιμέλεια thesqual87 / Kallm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open list maintained by the community, curated by thesqual87 / Kallm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista abierta mantenida por la comunidad, a cargo de thesqual87 / Kallm."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhteisön ylläpitämä avoin luettelo, kuratoinut thesqual87 / Kallm."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liste ouverte maintenue par la communauté, gérée par thesqual87 / Kallm."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સમુદાય દ્વારા જાળવવામાં આવેલી ઓપન લિસ્ટ, thesqual87 / Kallm દ્વારા ક્યુરેટેડ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רשימה פתוחה המתוחזקת על ידי הקהילה, בעריכת thesqual87 / Kallm."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समुदाय द्वारा बनाई रखी गई ओपन लिस्ट, thesqual87 / Kallm द्वारा क्यूरेट की गई।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvoreni popis koji održava zajednica, uređuju thesqual87 / Kallm."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A közösség által fenntartott nyílt lista, thesqual87 / Kallm szerkesztésében."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Daftar terbuka yang dikelola oleh komunitas, dikurasi oleh thesqual87 / Kallm."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista aperta e mantenuta dalla community, a cura di thesqual87 / Kallm."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コミュニティによって維持されているオープンリスト。thesqual87 / Kallmによるキュレーション。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಮುದಾಯದಿಂದ ನಿರ್ವಹಿಸಲ್ಪಡುವ ಮುಕ್ತ ಪಟ್ಟಿ, thesqual87 / Kallm ಇವರಿಂದ ಸಂಗ್ರಹಿಸಲಾಗಿದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커뮤니티가 관리하는 공개 목록, thesqual87 / Kallm이 큐레이션."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കമ്മ്യൂണിറ്റി പരിപാലിക്കുന്ന ഓപ്പൺ ലിസ്റ്റ്, thesqual87 / Kallm ക്യൂറേറ്റ് ചെയ്തത്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "समुदायाने सांभाळलेली खुली यादी, thesqual87 / Kallm यांनी क्युरेट केलेली."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Senarai terbuka yang diselenggara oleh komuniti, dikuratori oleh thesqual87 / Kallm."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpen liste vedlikeholdt av fellesskapet, kuratert av thesqual87 / Kallm."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open lijst onderhouden door de community, samengesteld door thesqual87 / Kallm."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସମ୍ପ୍ରଦାୟ ଦ୍ୱାରା ପରିଚାଳିତ ମୁକ୍ତ ତାଲିକା, thesqual87 / Kallm ଦ୍ୱାରା କ୍ୟୁରେଟ୍ କରାଯାଇଛି।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਮਿਊਨਿਟੀ ਦੁਆਰਾ ਬਣਾਈ ਰੱਖੀ ਗਈ ਖੁੱਲ੍ਹੀ ਸੂਚੀ, thesqual87 / Kallm ਦੁਆਰਾ ਕਿਊਰੇਟ ਕੀਤੀ ਗਈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwarta lista prowadzona przez społeczność, pod kuratelą thesqual87 / Kallm."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista aberta mantida pela comunidade, com curadoria de thesqual87 / Kallm."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista aberta mantida pela comunidade, com curadoria de thesqual87 / Kallm."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Listă deschisă întreținută de comunitate, curatoriată de thesqual87 / Kallm."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открытый список, поддерживаемый сообществом, курируется thesqual87 / Kallm."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorený zoznam udržiavaný komunitou, kurátori thesqual87 / Kallm."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odprt seznam, ki ga vzdržuje skupnost, uredila thesqual87 / Kallm."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppen lista som underhålls av communityn, kurerad av thesqual87 / Kallm."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சமூகத்தால் பராமரிக்கப்படும் திறந்த பட்டியல், thesqual87 / Kallm ஆல் தொகுக்கப்பட்டது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కమ్యూనిటీ నిర్వహించే ఓపెన్ లిస్ట్, thesqual87 / Kallm క్యురేట్ చేశారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการแบบเปิดที่ดูแลโดยชุมชน จัดทำโดย thesqual87 / Kallm"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Topluluk tarafından sürdürülen açık liste, thesqual87 / Kallm tarafından düzenlenmiştir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкритий список, який підтримує спільнота, курує thesqual87 / Kallm."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کمیونٹی کی طرف سے برقرار رکھی گئی اوپن لسٹ، thesqual87 / Kallm کی کیوریشن۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Danh sách mở do cộng đồng duy trì, biên tập bởi thesqual87 / Kallm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由社区维护的开放列表，由 thesqual87 / Kallm 策划。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由社群維護的開放清單，由 thesqual87 / Kallm 策劃。"
          }
        }
      }
    },
    "credits.source.bundesnetzagentur.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرقام اتخذت بشأنها الهيئة الاتحادية الألمانية للاتصالات (Bundesnetzagentur) إجراءً بالفعل بسبب إساءة الاستخدام (رسائل نصية مزعجة، برامج اتصال احتيالية، التلاعب بالأرقام وما شابه)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যে নম্বরগুলোর বিরুদ্ধে জার্মানির টেলিকম নিয়ন্ত্রক সংস্থা Bundesnetzagentur ইতিমধ্যে অপব্যবহারের (স্প্যাম এসএমএস, প্রতারণামূলক ডায়ালার, নম্বর কারচুপি ইত্যাদি) কারণে ব্যবস্থা নিয়েছে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Números contra els quals la Bundesnetzagentur, el regulador alemany de telecomunicacions, ja ha pres mesures per abús (SMS brossa, marcadors fraudulents, manipulació de número i similars)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čísla, proti kterým již Bundesnetzagentur, německý telekomunikační regulátor, zasáhl kvůli zneužití (spamové SMS, podvodné dialery, manipulace s číslem a podobné)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Numre, som Bundesnetzagentur, den tyske telemyndighed, allerede har grebet ind over for på grund af misbrug (spam-sms'er, svigagtige dialere, nummermanipulation og lignende)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rufnummern, gegen die die Bundesnetzagentur bereits wegen Missbrauchs (Spam-SMS, betrügerische Dialer, Rufnummernmanipulation u. Ä.) eine Maßnahme ergriffen hat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αριθμοί κατά των οποίων η Bundesnetzagentur, η γερμανική ρυθμιστική αρχή τηλεπικοινωνιών, έχει ήδη λάβει μέτρα για κατάχρηση (ανεπιθύμητα SMS, δόλιοι dialer, παραποίηση αριθμού και παρόμοια)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Numbers the Bundesnetzagentur, Germany's telecom regulator, has already taken enforcement action against for abuse (spam SMS, fraudulent dialers, number manipulation, and similar)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Números contra los que la Bundesnetzagentur, el regulador alemán de telecomunicaciones, ya ha tomado medidas por abuso (SMS spam, marcadores fraudulentos, manipulación de números y similares)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Numerot, joihin Saksan televiestintäviranomainen Bundesnetzagentur on jo puuttunut väärinkäytön vuoksi (roskaposti-tekstiviestit, vilpilliset valitsinohjelmat, numeron manipulointi ja vastaavat)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Numéros contre lesquels la Bundesnetzagentur, le régulateur allemand des télécommunications, a déjà pris des mesures pour abus (SMS indésirables, numéroteurs frauduleux, manipulation de numéro et autres)."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જર્મનીની ટેલિકોમ નિયમનકાર Bundesnetzagentur એ દુરુપયોગ (સ્પામ SMS, છેતરપિંડીયુક્ત ડાયલર, નંબર છેડછાડ અને તેના જેવા) બદલ પહેલેથી જ પગલાં લીધેલા નંબરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מספרים שנגדם כבר נקטה הרשות הגרמנית לתקשורת Bundesnetzagentur צעד אכיפה בשל שימוש לרעה (הודעות ספאם, חייגנים הונאה, מניפולציה במספר וכדומה)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वे नंबर जिनके ख़िलाफ़ जर्मनी के दूरसंचार नियामक Bundesnetzagentur ने दुरुपयोग (स्पैम एसएमएस, धोखाधड़ी वाले डायलर, नंबर में हेरफेर आदि) के लिए पहले ही कार्रवाई कर दी है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Brojevi protiv kojih je Bundesnetzagentur, njemački telekomunikacijski regulator, već poduzeo mjere zbog zlouporabe (neželjene SMS poruke, prijevarni dialeri, manipulacija brojem i slično)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Számok, amelyek ellen a Bundesnetzagentur, a német távközlési szabályozó hatóság, visszaélés (spam SMS, csalárd tárcsázóprogramok, számmanipuláció és hasonlók) miatt már intézkedést hozott."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomor yang sudah ditindak oleh Bundesnetzagentur, regulator telekomunikasi Jerman, karena penyalahgunaan (SMS spam, dialer penipuan, manipulasi nomor, dan sejenisnya)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Numeri su cui la Bundesnetzagentur, l'autorità tedesca delle telecomunicazioni, ha già preso un provvedimento per abuso (spam SMS, dialer truffaldini, manipolazione del numero e simili)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドイツの電気通信規制当局Bundesnetzagenturが、不正利用（迷惑SMS、詐欺的ダイヤラー、番号偽装など）を理由にすでに措置を講じた番号。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಜರ್ಮನಿಯ ದೂರಸಂಪರ್ಕ ನಿಯಂತ್ರಕ Bundesnetzagentur ದುರ್ಬಳಕೆಗಾಗಿ (ಸ್ಪ್ಯಾಮ್ SMS, ಮೋಸದ ಡಯಲರ್‌ಗಳು, ಸಂಖ್ಯೆ ಕುಶಲತೆ ಮತ್ತು ಅಂತಹುದೇ) ಈಗಾಗಲೇ ಕ್ರಮ ತೆಗೆದುಕೊಂಡ ಸಂಖ್ಯೆಗಳು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "독일 통신 규제 기관 Bundesnetzagentur가 남용(스팸 SMS, 사기성 다이얼러, 번호 조작 등)으로 이미 조치를 취한 번호."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ദുരുപയോഗത്തിന് (സ്പാം SMS, വഞ്ചനാപരമായ ഡയലറുകൾ, നമ്പർ കൃത്രിമം തുടങ്ങിയവ) ജർമ്മൻ ടെലികോം റെഗുലേറ്ററായ Bundesnetzagentur ഇതിനകം നടപടി സ്വീകരിച്ച നമ്പറുകൾ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जर्मनीच्या दूरसंचार नियामक Bundesnetzagentur ने गैरवापरासाठी (स्पॅम एसएमएस, फसवे डायलर, क्रमांकात फेरफार इ.) आधीच कारवाई केलेले क्रमांक."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombor yang telah diambil tindakan oleh Bundesnetzagentur, badan pengawal selia telekomunikasi Jerman, kerana penyalahgunaan (SMS spam, dialer penipuan, manipulasi nombor dan seumpamanya)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Numre som Bundesnetzagentur, den tyske telemyndigheten, allerede har grepet inn mot på grunn av misbruk (spam-SMS, svindelaktige dialere, nummermanipulasjon og lignende)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nummers waartegen de Bundesnetzagentur, de Duitse telecomtoezichthouder, al is opgetreden wegens misbruik (spam-sms, frauduleuze dialers, nummermanipulatie en vergelijkbare zaken)."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଜର୍ମାନୀର ଟେଲିକମ୍ ନିୟାମକ Bundesnetzagentur ଦୁରୁପଯୋଗ (ସ୍ପାମ୍ SMS, ଠକେଇ ଡାୟଲର୍, ନମ୍ବର ହେରାଫେରି ଏବଂ ସମାନ) ପାଇଁ ପୂର୍ବରୁ ପଦକ୍ଷେପ ନେଇଥିବା ନମ୍ବରଗୁଡ଼ିକ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਉਹ ਨੰਬਰ ਜਿਨ੍ਹਾਂ ਵਿਰੁੱਧ ਜਰਮਨੀ ਦੇ ਦੂਰਸੰਚਾਰ ਰੈਗੂਲੇਟਰ Bundesnetzagentur ਨੇ ਦੁਰਵਰਤੋਂ (ਸਪੈਮ SMS, ਧੋਖਾਧੜੀ ਵਾਲੇ ਡਾਇਲਰ, ਨੰਬਰ ਹੇਰਾਫੇਰੀ ਆਦਿ) ਲਈ ਪਹਿਲਾਂ ਹੀ ਕਾਰਵਾਈ ਕੀਤੀ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Numery, wobec których Bundesnetzagentur, niemiecki regulator telekomunikacyjny, podjął już działania z powodu nadużyć (spam SMS, oszukańcze dialery, manipulacja numerem i podobne)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Números contra os quais a Bundesnetzagentur, o regulador alemão das telecomunicações, já tomou medidas por abuso (SMS spam, discadores fraudulentos, manipulação de número e semelhantes)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Números contra os quais a Bundesnetzagentur, o regulador alemão das telecomunicações, já tomou medidas por abuso (SMS spam, discadores fraudulentos, manipulação de número e semelhantes)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numere împotriva cărora Bundesnetzagentur, autoritatea germană de reglementare a telecomunicațiilor, a luat deja măsuri pentru abuz (SMS-uri spam, dialere frauduloase, manipularea numărului și altele asemănătoare)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Номера, в отношении которых немецкий регулятор связи Bundesnetzagentur уже принял меры за злоупотребления (спам-SMS, мошеннические дозвонщики, подмена номера и подобное)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čísla, proti ktorým už Bundesnetzagentur, nemecký telekomunikačný regulátor, zasiahol pre zneužitie (spamové SMS, podvodné dialery, manipulácia s číslom a podobné)."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Številke, proti katerim je Bundesnetzagentur, nemški telekomunikacijski regulator, že ukrepal zaradi zlorabe (neželena SMS-sporočila, goljufivi klicniki, manipulacija s številko in podobno)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nummer som Bundesnetzagentur, den tyska telemyndigheten, redan har vidtagit åtgärder mot på grund av missbruk (spam-sms, bedrägliga uppringare, nummermanipulation och liknande)."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முறைகேடு (ஸ்பேம் SMS, மோசடி டயலர்கள், எண் கையாளுதல் மற்றும் பிற) காரணமாக ஜெர்மனியின் தொலைத்தொடர்பு கட்டுப்பாட்டு நிறுவனமான Bundesnetzagentur ஏற்கனவே நடவடிக்கை எடுத்த எண்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దుర్వినియోగం (స్పామ్ SMS, మోసపూరిత డయలర్‌లు, నంబర్ మానిప్యులేషన్ మొదలైనవి) కారణంగా జర్మనీ టెలికాం రెగ్యులేటర్ Bundesnetzagentur ఇప్పటికే చర్య తీసుకున్న నంబర్లు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หมายเลขที่หน่วยงานกำกับดูแลโทรคมนาคมของเยอรมนี Bundesnetzagentur ได้ดำเนินมาตรการแล้วเนื่องจากการใช้ในทางที่ผิด (SMS สแปม โปรแกรมหมุนโทรศัพท์หลอกลวง การปลอมแปลงหมายเลข และอื่น ๆ)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Almanya telekomünikasyon düzenleyicisi Bundesnetzagentur'un kötüye kullanım (spam SMS, sahte çeviriciler, numara manipülasyonu ve benzerleri) nedeniyle şimdiden işlem yaptığı numaralar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Номери, щодо яких німецький регулятор зв'язку Bundesnetzagentur уже вжив заходів за зловживання (спам-SMS, шахрайські дозвонювачі, маніпуляція номером тощо)."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وہ نمبرز جن کے خلاف جرمنی کے ٹیلی کام ریگولیٹر Bundesnetzagentur نے غلط استعمال (اسپیم ایس ایم ایس، فراڈ ڈائلرز، نمبر میں ہیرا پھیری وغیرہ) کی بنا پر پہلے ہی کارروائی کر دی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các số điện thoại mà Bundesnetzagentur, cơ quan quản lý viễn thông Đức, đã thực hiện biện pháp xử lý do lạm dụng (SMS rác, trình quay số lừa đảo, giả mạo số và tương tự)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "德国电信监管机构 Bundesnetzagentur 已经针对滥用行为（垃圾短信、欺诈性拨号程序、号码篡改等）采取处罚措施的号码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "德國電信監管機構 Bundesnetzagentur 已針對濫用行為（垃圾簡訊、詐騙撥號程式、號碼竄改等）採取處分措施的號碼。"
          }
        }
      }
    },
    "credits.source.callavert.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرقام سبام أمريكية مُجمَّعة من بيانات \"عدم الاتصال\" العامة الصادرة عن FTC، من إعداد مشروع Call Avert."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "FTC-এর সরকারি \"Do Not Call\" ডেটা থেকে সংকলিত মার্কিন স্প্যাম নম্বর, Call Avert প্রকল্প দ্বারা কিউরেট করা।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Números de spam dels EUA compilats a partir de les dades públiques \"Do Not Call\" de la FTC, a cura del projecte Call Avert."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Americká spamová čísla sestavená z veřejných dat FTC „Do Not Call“, kurátor projektu Call Avert."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Amerikanske spam-numre udarbejdet fra FTC's offentlige \"Do Not Call\"-data, kurateret af Call Avert-projektet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "US-Spam-Nummern, zusammengestellt aus den öffentlichen „Do Not Call“-Daten der FTC, kuratiert vom Call-Avert-Projekt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αμερικανικοί αριθμοί ανεπιθύμητων κλήσεων που συγκεντρώθηκαν από τα δημόσια δεδομένα «Do Not Call» της FTC, επιμέλεια του έργου Call Avert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "US spam numbers compiled from the FTC's public \"Do Not Call\" data, curated by the Call Avert project."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Números spam estadounidenses compilados a partir de los datos públicos \"Do Not Call\" de la FTC, a cargo del proyecto Call Avert."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdysvaltalaiset roskapuhelunumerot koottu FTC:n julkisista \"Do Not Call\" -tiedoista, kuratoinut Call Avert -hanke."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Numéros indésirables américains compilés à partir des données publiques « Do Not Call » de la FTC, gérés par le projet Call Avert."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "FTC ના જાહેર \"Do Not Call\" ડેટા પરથી સંકલિત યુએસ સ્પામ નંબરો, Call Avert પ્રોજેક્ટ દ્વારા ક્યુરેટેડ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מספרי ספאם אמריקאיים שנאספו מנתוני \"Do Not Call\" הציבוריים של ה-FTC, בעריכת פרויקט Call Avert."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "FTC के सार्वजनिक \"Do Not Call\" डेटा से संकलित अमेरिकी स्पैम नंबर, Call Avert परियोजना द्वारा क्यूरेट किए गए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Američki spam brojevi prikupljeni iz javnih podataka \"Do Not Call\" FTC-a, uređuje projekt Call Avert."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az FTC nyilvános „Do Not Call” adataiból összeállított amerikai spam számok, a Call Avert projekt szerkesztésében."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomor spam AS yang dikompilasi dari data publik \"Do Not Call\" FTC, dikurasi oleh proyek Call Avert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Numeri spam statunitensi compilati dai dati pubblici \"Do Not Call\" della FTC, a cura del progetto Call Avert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "FTCの公開「Do Not Call」データから編集された米国のスパム番号。Call Avertプロジェクトによるキュレーション。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "FTC ಯ ಸಾರ್ವಜನಿಕ \"Do Not Call\" ಡೇಟಾದಿಂದ ಸಂಗ್ರಹಿಸಲಾದ US ಸ್ಪ್ಯಾಮ್ ಸಂಖ್ಯೆಗಳು, Call Avert ಯೋಜನೆಯಿಂದ ಸಂಗ್ರಹಿಸಲಾಗಿದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "FTC의 공개 \"Do Not Call\" 데이터에서 수집한 미국 스팸 번호, Call Avert 프로젝트가 큐레이션."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "FTC യുടെ പൊതു \"Do Not Call\" ഡാറ്റയിൽ നിന്ന് സമാഹരിച്ച യുഎസ് സ്പാം നമ്പറുകൾ, Call Avert പ്രോജക്റ്റ് ക്യൂറേറ്റ് ചെയ്തത്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "FTC च्या सार्वजनिक \"Do Not Call\" डेटावरून संकलित केलेले अमेरिकी स्पॅम क्रमांक, Call Avert प्रकल्पाने क्युरेट केलेले."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombor spam AS yang dikumpulkan daripada data awam \"Do Not Call\" FTC, dikuratori oleh projek Call Avert."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Amerikanske spam-numre samlet fra FTCs offentlige \"Do Not Call\"-data, kuratert av Call Avert-prosjektet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Amerikaanse spamnummers samengesteld uit de openbare \"Do Not Call\"-gegevens van de FTC, samengesteld door het Call Avert-project."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "FTC ର ସାର୍ବଜନୀନ \"Do Not Call\" ତଥ୍ୟରୁ ସଂକଳିତ ଆମେରିକୀୟ ସ୍ପାମ ନମ୍ବରଗୁଡ଼ିକ, Call Avert ପ୍ରୋଜେକ୍ଟ ଦ୍ୱାରା କ୍ୟୁରେଟ୍ କରାଯାଇଛି।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "FTC ਦੇ ਜਨਤਕ \"Do Not Call\" ਡੇਟਾ ਤੋਂ ਸੰਕਲਿਤ ਅਮਰੀਕੀ ਸਪੈਮ ਨੰਬਰ, Call Avert ਪ੍ਰੋਜੈਕਟ ਦੁਆਰਾ ਕਿਊਰੇਟ ਕੀਤੇ ਗਏ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Amerykańskie numery spamowe zestawione z publicznych danych FTC „Do Not Call”, pod kuratelą projektu Call Avert."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Números de spam dos EUA compilados a partir dos dados públicos \"Do Not Call\" da FTC, com curadoria do projeto Call Avert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Números de spam dos EUA compilados a partir dos dados públicos \"Do Not Call\" da FTC, com curadoria do projeto Call Avert."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numere de spam din SUA compilate din datele publice „Do Not Call” ale FTC, curatoriate de proiectul Call Avert."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Американские спам-номера, составленные из публичных данных FTC «Do Not Call», курируется проектом Call Avert."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Americké spamové čísla zostavené z verejných údajov FTC „Do Not Call“, kurátor projektu Call Avert."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ameriške številke neželenih klicev, zbrane iz javnih podatkov FTC \"Do Not Call\", uredil projekt Call Avert."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Amerikanska spamnummer sammanställda från FTC:s offentliga \"Do Not Call\"-data, kurerad av Call Avert-projektet."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "FTC இன் பொது \"Do Not Call\" தரவிலிருந்து தொகுக்கப்பட்ட அமெரிக்க ஸ்பாம் எண்கள், Call Avert திட்டத்தால் தொகுக்கப்பட்டது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "FTC పబ్లిక్ \"Do Not Call\" డేటా నుండి సంకలనం చేసిన US స్పామ్ నంబర్లు, Call Avert ప్రాజెక్ట్ క్యురేట్ చేసింది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หมายเลขสแปมของสหรัฐฯ ที่รวบรวมจากข้อมูลสาธารณะ \"Do Not Call\" ของ FTC จัดทำโดยโครงการ Call Avert"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "FTC'nin kamuya açık \"Do Not Call\" verilerinden derlenen ABD spam numaraları, Call Avert projesi tarafından düzenlenmiştir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Американські спам-номери, зібрані з публічних даних FTC «Do Not Call», курує проєкт Call Avert."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "FTC کے عوامی \"Do Not Call\" ڈیٹا سے مرتب کردہ امریکی اسپیم نمبرز، Call Avert پراجیکٹ کی کیوریشن۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số spam Mỹ được tổng hợp từ dữ liệu công khai \"Do Not Call\" của FTC, biên tập bởi dự án Call Avert."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据美国联邦贸易委员会（FTC）公开的「请勿致电」数据汇编的美国垃圾号码，由 Call Avert 项目策划。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根據美國聯邦貿易委員會（FTC）公開的「請勿來電」資料彙編的美國垃圾號碼，由 Call Avert 計畫策劃。"
          }
        }
      }
    },
    "credits.source.community.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرقام أبلغت عنها مباشرة مجتمع NoSpam (5 بلاغات على الأقل من مستخدمين مختلفين)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "NoSpam কমিউনিটি দ্বারা সরাসরি রিপোর্ট করা নম্বর (বিভিন্ন ব্যবহারকারীর কাছ থেকে কমপক্ষে ৫টি রিপোর্ট)।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Números denunciats directament per la comunitat de NoSpam (almenys 5 denúncies d'usuaris diferents)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
