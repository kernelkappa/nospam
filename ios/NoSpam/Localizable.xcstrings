          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyyntö kesti liian kauan: yritä myöhemmin uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La requête a pris trop de temps : veuillez réessayer plus tard."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વિનંતીમાં ઘણો સમય લાગ્યો: પછી ફરી પ્રયાસ કરો."
