        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವಿನಂತಿಯು ಹೆಚ್ಚು ಸಮಯ ತೆಗೆದುಕೊಂಡಿತು: ನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
