        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Databáze byla aktualizována. Pro aktivaci blokování klepněte výše na „Otevřít Nastavení“ a postupujte podle návodu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
