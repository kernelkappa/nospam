    "settings.language.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر لغة التطبيق، بشكل مستقل عن لغة هاتفك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফোনের ভাষা থেকে স্বতন্ত্রভাবে অ্যাপের ভাষা বেছে নিন।"
          }
        },
        "ca": {
          "stringUnit": {
