    "onboarding.message": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per bloccare automaticamente le chiamate spam, NoSpam deve essere abilitato da Impostazioni > Telefono > Blocco e identificazione chiamate. Ti guidiamo passo passo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To automatically block spam calls, NoSpam needs to be enabled from Settings > Phone > Call Blocking & Identification. We'll guide you step by step."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para bloquear automáticamente las llamadas spam, NoSpam debe activarse desde Ajustes > Teléfono > Bloqueo e identificación de llamadas. Te guiamos paso a paso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour bloquer automatiquement les appels indésirables, NoSpam doit être activé depuis Réglages > Téléphone > Blocage et identification des appels. Nous vous guidons étape par étape."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Spam-Anrufe automatisch zu blockieren, muss NoSpam unter Einstellungen > Telefon > Anrufe blockieren & identifizieren aktiviert werden. Wir führen dich Schritt für Schritt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para bloquear automaticamente chamadas spam, o NoSpam deve ser ativado em Definições > Telefone > Bloqueio e identificação de chamadas. Guiamo-lo passo a passo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لحظر مكالمات السبام تلقائيًا، يجب تفعيل NoSpam من الإعدادات > الهاتف > حظر المكالمات وتحديد الهوية. سنوجهك خطوة بخطوة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্প্যাম কল স্বয়ংক্রিয়ভাবে ব্লক করতে, সেটিংস > ফোন > কল ব্লকিং ও আইডেন্টিফিকেশন থেকে NoSpam সক্রিয় করতে হবে। আমরা আপনাকে ধাপে ধাপে গাইড করব।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per bloquejar automàticament les trucades brossa, cal activar NoSpam des de Configuració > Telèfon > Bloqueig i identificació de trucades. T'ho guiarem pas a pas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要自动拦截垃圾来电，需要在设置 > 电话 > 来电拦截与身份识别中启用 NoSpam。我们会一步步引导你完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若要自動封鎖垃圾來電，需要從設定 > 電話 > 來電封鎖與識別中啟用 NoSpam。我們會逐步引導你完成。"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za automatsko blokiranje neželjenih poziva, NoSpam treba omogućiti u Postavke > Telefon > Blokiranje i identifikacija poziva. Vodit ćemo vas korak po korak."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro automatické blokování spamových hovorů musí být NoSpam povolen v Nastavení > Telefon > Blokování a identifikace hovorů. Provedeme vás krok za krokem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For automatisk at blokere spamopkald skal NoSpam aktiveres fra Indstillinger > Telefon > Opkaldsblokering og -identifikation. Vi guider dig trin for trin."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om spamoproepen automatisch te blokkeren, moet NoSpam worden ingeschakeld via Instellingen > Telefoon > Oproepblokkering en -identificatie. We begeleiden je stap voor stap."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Roskapuheluiden automaattista estämistä varten NoSpam on otettava käyttöön kohdassa Asetukset > Puhelin > Puhelunesto ja tunnistus. Opastamme sinua vaihe vaiheelta."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για αυτόματο αποκλεισμό ανεπιθύμητων κλήσεων, το NoSpam πρέπει να ενεργοποιηθεί από Ρυθμίσεις > Τηλέφωνο > Αποκλεισμός και αναγνώριση κλήσεων. Θα σας καθοδηγήσουμε βήμα προς βήμα."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સ્પામ કૉલ્સને સ્વચાલિત રીતે બ્લોક કરવા માટે, NoSpam ને સેટિંગ્સ > ફોન > કૉલ બ્લોકિંગ અને ઓળખ માંથી સક્રિય કરવું જરૂરી છે. અમે તમને પગલું-દર-પગલું માર્ગદર્શન આપીશું."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי לחסום שיחות זבל באופן אוטומטי, יש להפעיל את NoSpam מתוך הגדרות > טלפון > חסימת שיחות וזיהוי. נדריך אותך שלב אחר שלב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्पैम कॉल को स्वचालित रूप से ब्लॉक करने के लिए, NoSpam को सेटिंग्स > फ़ोन > कॉल ब्लॉकिंग और पहचान से सक्षम करना होगा। हम आपको चरण-दर-चरण मार्गदर्शन देंगे।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A spamhívások automatikus blokkolásához a NoSpam-et engedélyezni kell a Beállítások > Telefon > Hívásblokkolás és azonosítás menüben. Lépésről lépésre végigvezetjük."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk memblokir panggilan spam secara otomatis, NoSpam harus diaktifkan dari Pengaturan > Telepon > Pemblokiran & Identifikasi Panggilan. Kami akan memandu Anda langkah demi langkah."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スパム着信を自動的にブロックするには、設定 > 電話 > 着信ブロックと番号識別からNoSpamを有効にする必要があります。手順をご案内します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಪ್ಯಾಮ್ ಕರೆಗಳನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ನಿರ್ಬಂಧಿಸಲು, NoSpam ಅನ್ನು ಸೆಟ್ಟಿಂಗ್‌ಗಳು > ಫೋನ್ > ಕರೆ ನಿರ್ಬಂಧ ಮತ್ತು ಗುರುತಿಸುವಿಕೆಯಿಂದ ಸಕ್ರಿಯಗೊಳಿಸಬೇಕು. ನಾವು ನಿಮಗೆ ಹಂತ ಹಂತವಾಗಿ ಮಾರ್ಗದರ್ಶನ ನೀಡುತ್ತೇವೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스팸 전화를 자동으로 차단하려면 설정 > 전화 > 전화 차단 및 식별에서 NoSpam을 활성화해야 합니다. 단계별로 안내해 드립니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menyekat panggilan spam secara automatik, NoSpam perlu didayakan daripada Tetapan > Telefon > Sekatan & Pengenalan Panggilan. Kami akan membimbing anda langkah demi langkah."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്പാം കോളുകൾ സ്വയമേവ ബ്ലോക്ക് ചെയ്യാൻ, NoSpam ക്രമീകരണങ്ങൾ > ഫോൺ > കോൾ ബ്ലോക്കിംഗും തിരിച്ചറിയലും എന്നതിൽ നിന്ന് പ്രവർത്തനക്ഷമമാക്കേണ്ടതുണ്ട്. ഞങ്ങൾ നിങ്ങളെ ഘട്ടം ഘട്ടമായി സഹായിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्पॅम कॉल्स स्वयंचलितपणे ब्लॉक करण्यासाठी, NoSpam सेटिंग्ज > फोन > कॉल ब्लॉकिंग आणि ओळख मधून सक्षम करणे आवश्यक आहे. आम्ही तुम्हाला टप्प्याटप्प्याने मार्गदर्शन करू."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For å automatisk blokkere spamanrop, må NoSpam aktiveres fra Innstillinger > Telefon > Anropsblokkering og -identifikasjon. Vi veileder deg trinn for trinn."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସ୍ପାମ୍ କଲ୍‌ଗୁଡ଼ିକୁ ସ୍ୱୟଂଚାଳିତ ଭାବରେ ବ୍ଲକ୍ କରିବାକୁ, NoSpam କୁ ସେଟିଂସ୍‌ > ଫୋନ୍ > କଲ୍ ବ୍ଲକିଂ ଏବଂ ପରିଚୟରୁ ସକ୍ଷମ କରିବାକୁ ପଡ଼ିବ। ଆମେ ଆପଣଙ୍କୁ ପର୍ଯ୍ୟାୟକ୍ରମେ ମାର୍ଗଦର୍ଶନ କରିବୁ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby automatycznie blokować spamowe połączenia, NoSpam musi być włączony w Ustawienia > Telefon > Blokowanie i identyfikacja połączeń. Przeprowadzimy Cię krok po kroku."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਪੈਮ ਕਾਲਾਂ ਨੂੰ ਆਟੋਮੈਟਿਕਲੀ ਬਲਾਕ ਕਰਨ ਲਈ, NoSpam ਨੂੰ ਸੈਟਿੰਗਾਂ > ਫ਼ੋਨ > ਕਾਲ ਬਲਾਕਿੰਗ ਅਤੇ ਪਛਾਣ ਤੋਂ ਸਮਰੱਥ ਕਰਨਾ ਜ਼ਰੂਰੀ ਹੈ। ਅਸੀਂ ਤੁਹਾਨੂੰ ਕਦਮ-ਦਰ-ਕਦਮ ਮਾਰਗਦਰਸ਼ਨ ਦੇਵਾਂਗੇ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para bloquear automaticamente chamadas de spam, o NoSpam precisa ser ativado em Configurações > Telefone > Bloqueio e Identificação de Chamadas. Vamos guiá-lo passo a passo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a bloca automat apelurile spam, NoSpam trebuie activat din Setări > Telefon > Blocare și identificare apeluri. Te vom ghida pas cu pas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы автоматически блокировать спам-звонки, необходимо включить NoSpam в разделе Настройки > Телефон > Блокировка и идентификация звонков. Мы шаг за шагом поможем вам."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na automatické blokovanie spamových hovorov musí byť NoSpam povolený v Nastavenia > Telefón > Blokovanie a identifikácia hovorov. Krok za krokom vás prevedieme."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za samodejno blokiranje vsiljenih klicev je treba NoSpam omogočiti v Nastavitve > Telefon > Blokiranje in prepoznavanje klicev. Vodili vas bomo korak za korakom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att automatiskt blockera skräpsamtal måste NoSpam aktiveras från Inställningar > Telefon > Samtalsblockering och identifiering. Vi guidar dig steg för steg."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஸ்பாம் அழைப்புகளைத் தானாகத் தடுக்க, NoSpam-ஐ அமைப்புகள் > தொலைபேசி > அழைப்பு தடுப்பு & அடையாளம் காணுதல் இலிருந்து இயக்க வேண்டும். நாங்கள் உங்களுக்கு படிப்படியாக வழிகாட்டுவோம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్పామ్ కాల్‌లను స్వయంచాలకంగా బ్లాక్ చేయడానికి, NoSpamను సెట్టింగ్‌లు > ఫోన్ > కాల్ బ్లాకింగ్ & గుర్తింపు నుండి ప్రారంభించాలి. మేము మీకు దశల వారీగా మార్గనిర్దేశం చేస్తాము."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพื่อบล็อกสายสแปมโดยอัตโนมัติ ต้องเปิดใช้งาน NoSpam จากการตั้งค่า > โทรศัพท์ > การบล็อกและระบุตัวตนสาย เราจะแนะนำคุณทีละขั้นตอน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spam aramaları otomatik olarak engellemek için NoSpam'in Ayarlar > Telefon > Çağrı Engelleme ve Tanımlama bölümünden etkinleştirilmesi gerekir. Size adım adım yol göstereceğiz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб автоматично блокувати спам-дзвінки, потрібно увімкнути NoSpam у Налаштування > Телефон > Блокування та ідентифікація викликів. Ми крок за кроком допоможемо вам."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسپیم کالز کو خود بخود بلاک کرنے کے لیے، NoSpam کو سیٹنگز > فون > کال بلاکنگ اور شناخت سے فعال کرنا ہوگا۔ ہم آپ کو مرحلہ وار رہنمائی فراہم کریں گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để tự động chặn các cuộc gọi spam, NoSpam cần được bật từ Cài đặt > Điện thoại > Chặn & Nhận dạng cuộc gọi. Chúng tôi sẽ hướng dẫn bạn từng bước."
          }
        }
      }
    },
    "settingsGuide.message": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impostazioni si aprirà sulla pagina di NoSpam, non su quella giusta. Da lì:\n\n1. Torna alla schermata principale di Impostazioni (tocca « ‹ Impostazioni » in alto a sinistra)\n2. Tocca Telefono\n3. Tocca Blocco e identificazione chiamate\n4. Attiva l'interruttore NoSpam"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings will open on NoSpam's own page, not the right one. From there:\n\n1. Go back to the main Settings screen (tap « ‹ Settings » at the top left)\n2. Tap Phone\n3. Tap Call Blocking & Identification\n4. Turn on the NoSpam switch"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes se abrirá en la página de NoSpam, no en la correcta. Desde allí:\n\n1. Vuelve a la pantalla principal de Ajustes (toca « ‹ Ajustes » arriba a la izquierda)\n2. Toca Teléfono\n3. Toca Bloqueo e identificación de llamadas\n4. Activa el interruptor de NoSpam"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglages s'ouvrira sur la page de NoSpam, pas la bonne. À partir de là :\n\n1. Revenez à l'écran principal de Réglages (appuyez sur « ‹ Réglages » en haut à gauche)\n2. Appuyez sur Téléphone\n3. Appuyez sur Blocage et identification des appels\n4. Activez l'interrupteur NoSpam"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen öffnet sich auf der Seite von NoSpam, nicht auf der richtigen. Von dort aus:\n\n1. Gehe zurück zum Hauptbildschirm der Einstellungen (tippe oben links auf „‹ Einstellungen“)\n2. Tippe auf Telefon\n3. Tippe auf Anrufe blockieren & identifizieren\n4. Aktiviere den NoSpam-Schalter"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As Definições abrirão na página do NoSpam, não na correta. A partir daí:\n\n1. Volte ao ecrã principal das Definições (toque em «‹ Definições» no canto superior esquerdo)\n2. Toque em Telefone\n3. Toque em Bloqueio e identificação de chamadas\n4. Ative o interruptor do NoSpam"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُفتح الإعدادات على صفحة NoSpam نفسها، وليس الصفحة الصحيحة. من هناك:\n\n1. ارجع إلى الشاشة الرئيسية للإعدادات (اضغط على « ‹ الإعدادات » في الأعلى)\n2. اضغط على الهاتف\n3. اضغط على حظر المكالمات وتحديد الهوية\n4. فعِّل مفتاح NoSpam"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সেটিংস NoSpam-এর নিজের পেজে খুলবে, সঠিক পেজে নয়। সেখান থেকে:\n\n1. সেটিংস-এর মূল স্ক্রিনে ফিরে যান (উপরে বাম দিকে « ‹ সেটিংস » ট্যাপ করুন)\n2. ফোন-এ ট্যাপ করুন\n3. কল ব্লকিং ও আইডেন্টিফিকেশন-এ ট্যাপ করুন\n4. NoSpam সুইচ চালু করুন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuració s'obrirà a la pàgina pròpia de NoSpam, no a la correcta. Des d'allà:\n\n1. Torna a la pantalla principal de Configuració (toca « ‹ Configuració » a dalt a l'esquerra)\n2. Toca Telèfon\n3. Toca Bloqueig i identificació de trucades\n4. Activa l'interruptor de NoSpam"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置会打开 NoSpam 自己的页面，而不是正确的页面。从那里：\n\n1. 返回设置主屏幕（点按左上方的“‹ 设置”）\n2. 点按“电话”\n3. 点按“来电拦截与身份识别”\n4. 打开 NoSpam 开关"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定會開啟 NoSpam 自己的頁面，而非正確的頁面。從那裡：\n\n1. 返回設定主畫面（點一下左上方的「‹ 設定」）\n2. 點一下「電話」\n3. 點一下「來電封鎖與識別」\n4. 開啟 NoSpam 開關"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Postavke će se otvoriti na vlastitoj stranici NoSpama, a ne na pravoj. Odatle:\n\n1. Vratite se na glavni zaslon Postavki (dotaknite « ‹ Postavke » u gornjem lijevom kutu)\n2. Dotaknite Telefon\n3. Dotaknite Blokiranje i identifikacija poziva\n4. Uključite prekidač NoSpam"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavení se otevře na vlastní stránce NoSpam, ne na správné. Odtud:\n\n1. Vraťte se na hlavní obrazovku Nastavení (klepněte vlevo nahoře na „‹ Nastavení“)\n2. Klepněte na Telefon\n3. Klepněte na Blokování a identifikace hovorů\n4. Zapněte přepínač NoSpam"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indstillinger åbner på NoSpams egen side, ikke den rigtige. Derfra:\n\n1. Gå tilbage til hovedskærmen i Indstillinger (tryk på « ‹ Indstillinger » øverst til venstre)\n2. Tryk på Telefon\n3. Tryk på Opkaldsblokering og -identifikation\n4. Aktivér NoSpam-kontakten"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instellingen opent op de eigen pagina van NoSpam, niet de juiste. Vanaf daar:\n\n1. Ga terug naar het hoofdscherm van Instellingen (tik linksboven op « ‹ Instellingen »)\n2. Tik op Telefoon\n3. Tik op Oproepblokkering en -identificatie\n4. Schakel de NoSpam-schakelaar in"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asetukset avautuu NoSpamin omalle sivulle, ei oikealle. Sieltä:\n\n1. Palaa Asetusten päänäytölle (napauta vasemmassa yläkulmassa « ‹ Asetukset »)\n2. Napauta Puhelin\n3. Napauta Puhelunesto ja tunnistus\n4. Ota NoSpam-kytkin käyttöön"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι Ρυθμίσεις θα ανοίξουν στη δική της σελίδα του NoSpam, όχι στη σωστή. Από εκεί:\n\n1. Επιστρέψτε στην κύρια οθόνη Ρυθμίσεων (πατήστε « ‹ Ρυθμίσεις » πάνω αριστερά)\n2. Πατήστε Τηλέφωνο\n3. Πατήστε Αποκλεισμός και αναγνώριση κλήσεων\n4. Ενεργοποιήστε τον διακόπτη NoSpam"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સેટિંગ્સ NoSpam ના પોતાના પેજ પર ખુલશે, યોગ્ય પેજ પર નહીં. ત્યાંથી:\n\n1. સેટિંગ્સની મુખ્ય સ્ક્રીન પર પાછા જાઓ (ઉપર ડાબી બાજુ « ‹ સેટિંગ્સ » ટૅપ કરો)\n2. ફોન પર ટૅપ કરો\n3. કૉલ બ્લોકિંગ અને ઓળખ પર ટૅપ કરો\n4. NoSpam સ્વિચ ચાલુ કરો"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההגדרות יפתחו בעמוד של NoSpam עצמו, לא בעמוד הנכון. משם:\n\n1. חזור למסך הראשי של ההגדרות (הקש על « ‹ הגדרות » בחלק העליון)\n2. הקש על טלפון\n3. הקש על חסימת שיחות וזיהוי\n4. הפעל את המתג של NoSpam"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग्स NoSpam के अपने पेज पर खुलेंगी, सही पेज पर नहीं। वहां से:\n\n1. सेटिंग्स की मुख्य स्क्रीन पर वापस जाएं (ऊपर बाईं ओर « ‹ सेटिंग्स » टैप करें)\n2. फ़ोन पर टैप करें\n3. कॉल ब्लॉकिंग और पहचान पर टैप करें\n4. NoSpam स्विच चालू करें"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Beállítások a NoSpam saját oldalán nyílik meg, nem a megfelelőn. Onnan:\n\n1. Térjen vissza a Beállítások főképernyőjére (koppintson a bal felső « ‹ Beállítások » gombra)\n2. Koppintson a Telefon elemre\n3. Koppintson a Hívásblokkolás és azonosítás elemre\n4. Kapcsolja be a NoSpam kapcsolót"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengaturan akan terbuka di halaman NoSpam sendiri, bukan halaman yang tepat. Dari sana:\n\n1. Kembali ke layar utama Pengaturan (ketuk « ‹ Pengaturan » di kiri atas)\n2. Ketuk Telepon\n3. Ketuk Pemblokiran & Identifikasi Panggilan\n4. Aktifkan sakelar NoSpam"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定はNoSpam自体のページで開き、正しいページではありません。そこから:\n\n1. 設定のメイン画面に戻る(左上の「‹ 設定」をタップ)\n2. 「電話」をタップ\n3. 「着信ブロックと番号識別」をタップ\n4. NoSpamのスイッチをオンにする"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸೆಟ್ಟಿಂಗ್‌ಗಳು NoSpam ನ ಸ್ವಂತ ಪುಟದಲ್ಲಿ ತೆರೆಯುತ್ತವೆ, ಸರಿಯಾದ ಪುಟದಲ್ಲಿ ಅಲ್ಲ. ಅಲ್ಲಿಂದ:\n\n1. ಸೆಟ್ಟಿಂಗ್‌ಗಳ ಮುಖ್ಯ ಪರದೆಗೆ ಹಿಂತಿರುಗಿ (ಮೇಲೆ ಎಡಭಾಗದಲ್ಲಿ « ‹ ಸೆಟ್ಟಿಂಗ್‌ಗಳು » ಟ್ಯಾಪ್ ಮಾಡಿ)\n2. ಫೋನ್ ಅನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ\n3. ಕರೆ ನಿರ್ಬಂಧ ಮತ್ತು ಗುರುತಿಸುವಿಕೆಯನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ\n4. NoSpam ಸ್ವಿಚ್ ಅನ್ನು ಆನ್ ಮಾಡಿ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정은 올바른 페이지가 아닌 NoSpam 자체 페이지에서 열립니다. 거기에서:\n\n1. 설정 메인 화면으로 돌아가세요 (왼쪽 상단의 « ‹ 설정 »을 탭하세요)\n2. 전화를 탭하세요\n3. 전화 차단 및 식별을 탭하세요\n4. NoSpam 스위치를 켜세요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetapan akan dibuka pada halaman NoSpam sendiri, bukan yang betul. Dari sana:\n\n1. Kembali ke skrin utama Tetapan (ketik « ‹ Tetapan » di kiri atas)\n2. Ketik Telefon\n3. Ketik Sekatan & Pengenalan Panggilan\n4. Hidupkan suis NoSpam"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ക്രമീകരണങ്ങൾ NoSpam ന്റെ സ്വന്തം പേജിലാണ് തുറക്കുന്നത്, ശരിയായ പേജിലല്ല. അവിടെ നിന്ന്:\n\n1. ക്രമീകരണങ്ങളുടെ പ്രധാന സ്ക്രീനിലേക്ക് മടങ്ങുക (മുകളിൽ ഇടത് വശത്ത് « ‹ ക്രമീകരണങ്ങൾ » ടാപ്പ് ചെയ്യുക)\n2. ഫോൺ ടാപ്പ് ചെയ്യുക\n3. കോൾ ബ്ലോക്കിംഗും തിരിച്ചറിയലും ടാപ്പ് ചെയ്യുക\n4. NoSpam സ്വിച്ച് ഓണാക്കുക"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग्ज NoSpam च्या स्वतःच्या पेजवर उघडतील, योग्य पेजवर नाही. तिथून:\n\n1. सेटिंग्जच्या मुख्य स्क्रीनवर परत जा (वर डावीकडे « ‹ सेटिंग्ज » टॅप करा)\n2. फोन टॅप करा\n3. कॉल ब्लॉकिंग आणि ओळख टॅप करा\n4. NoSpam स्विच सुरू करा"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Innstillinger åpnes på NoSpams egen side, ikke den riktige. Fra der:\n\n1. Gå tilbake til hovedskjermen i Innstillinger (trykk på « ‹ Innstillinger » øverst til venstre)\n2. Trykk på Telefon\n3. Trykk på Anropsblokkering og -identifikasjon\n4. Slå på NoSpam-bryteren"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସେଟିଂସ୍‌ NoSpam ର ନିଜ ପେଜ୍‌ରେ ଖୋଲିବ, ସଠିକ୍ ପେଜ୍‌ରେ ନୁହେଁ। ସେଠାରୁ:\n\n1. ସେଟିଂସ୍‌ର ମୁଖ୍ୟ ସ୍କ୍ରିନ୍‌କୁ ଫେରନ୍ତୁ (ଉପର ବାମକୁ « ‹ ସେଟିଂସ୍‌ » ଟାପ୍ କରନ୍ତୁ)\n2. ଫୋନ୍ ଟାପ୍ କରନ୍ତୁ\n3. କଲ୍ ବ୍ଲକିଂ ଏବଂ ପରିଚୟ ଟାପ୍ କରନ୍ତୁ\n4. NoSpam ସ୍ୱିଚ୍ ଅନ୍ କରନ୍ତୁ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawienia otworzą się na własnej stronie NoSpam, a nie na właściwej. Od tego miejsca:\n\n1. Wróć do głównego ekranu Ustawień (dotknij « ‹ Ustawienia » w lewym górnym rogu)\n2. Dotknij Telefon\n3. Dotknij Blokowanie i identyfikacja połączeń\n4. Włącz przełącznik NoSpam"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸੈਟਿੰਗਾਂ NoSpam ਦੇ ਆਪਣੇ ਪੇਜ 'ਤੇ ਖੁੱਲ੍ਹਣਗੀਆਂ, ਸਹੀ ਪੇਜ 'ਤੇ ਨਹੀਂ। ਉੱਥੋਂ:\n\n1. ਸੈਟਿੰਗਾਂ ਦੀ ਮੁੱਖ ਸਕ੍ਰੀਨ 'ਤੇ ਵਾਪਸ ਜਾਓ (ਉੱਪਰ ਖੱਬੇ ਪਾਸੇ « ‹ ਸੈਟਿੰਗਾਂ » ਟੈਪ ਕਰੋ)\n2. ਫ਼ੋਨ 'ਤੇ ਟੈਪ ਕਰੋ\n3. ਕਾਲ ਬਲਾਕਿੰਗ ਅਤੇ ਪਛਾਣ 'ਤੇ ਟੈਪ ਕਰੋ\n4. NoSpam ਸਵਿੱਚ ਚਾਲੂ ਕਰੋ"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As Configurações abrirão na própria página do NoSpam, não na correta. A partir daí:\n\n1. Volte para a tela principal de Configurações (toque em « ‹ Configurações » no canto superior esquerdo)\n2. Toque em Telefone\n3. Toque em Bloqueio e Identificação de Chamadas\n4. Ative a chave do NoSpam"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Setările se vor deschide pe propria pagină a NoSpam, nu pe cea corectă. De acolo:\n\n1. Revino la ecranul principal al Setărilor (apasă pe « ‹ Setări » în stânga sus)\n2. Apasă pe Telefon\n3. Apasă pe Blocare și identificare apeluri\n4. Activează comutatorul NoSpam"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки откроются на собственной странице NoSpam, а не на нужной. Оттуда:\n\n1. Вернитесь на главный экран настроек (нажмите « ‹ Настройки » в левом верхнем углу)\n2. Нажмите Телефон\n3. Нажмите Блокировка и идентификация звонков\n4. Включите переключатель NoSpam"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavenia sa otvoria na vlastnej stránke NoSpam, nie na správnej. Odtiaľ:\n\n1. Vráťte sa na hlavnú obrazovku Nastavení (klepnite vľavo nahore na „‹ Nastavenia“)\n2. Klepnite na Telefón\n3. Klepnite na Blokovanie a identifikácia hovorov\n4. Zapnite prepínač NoSpam"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavitve se bodo odprle na lastni strani NoSpam, ne na pravi. Od tam:\n\n1. Vrnite se na glavni zaslon Nastavitev (dotaknite se zgoraj levo »‹ Nastavitve«)\n2. Dotaknite se Telefon\n3. Dotaknite se Blokiranje in prepoznavanje klicev\n4. Vklopite stikalo NoSpam"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inställningar öppnas på NoSpams egen sida, inte den rätta. Därifrån:\n\n1. Gå tillbaka till Inställningars huvudskärm (tryck på « ‹ Inställningar » högst upp till vänster)\n2. Tryck på Telefon\n3. Tryck på Samtalsblockering och identifiering\n4. Slå på NoSpam-reglaget"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அமைப்புகள் NoSpam-இன் சொந்தப் பக்கத்தில் திறக்கும், சரியான பக்கத்தில் அல்ல. அங்கிருந்து:\n\n1. அமைப்புகளின் முதன்மைத் திரைக்குத் திரும்பவும் (மேல் இடதுபுறம் « ‹ அமைப்புகள் » என்பதைத் தட்டவும்)\n2. தொலைபேசி என்பதைத் தட்டவும்\n3. அழைப்பு தடுப்பு & அடையாளம் காணுதல் என்பதைத் தட்டவும்\n4. NoSpam சுவிட்சை இயக்கவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సెట్టింగ్‌లు NoSpam స్వంత పేజీలో తెరవబడతాయి, సరైన పేజీలో కాదు. అక్కడ నుండి:\n\n1. సెట్టింగ్‌ల ముఖ్య స్క్రీన్‌కు తిరిగి వెళ్లండి (ఎగువ ఎడమవైపు « ‹ సెట్టింగ్‌లు » నొక్కండి)\n2. ఫోన్ నొక్కండి\n3. కాల్ బ్లాకింగ్ & గుర్తింపు నొక్కండి\n4. NoSpam స్విచ్‌ను ఆన్ చేయండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตั้งค่าจะเปิดที่หน้าของ NoSpam เอง ไม่ใช่หน้าที่ถูกต้อง จากที่นั่น:\n\n1. กลับไปที่หน้าจอหลักของการตั้งค่า (แตะ « ‹ การตั้งค่า » ที่ด้านซ้ายบน)\n2. แตะโทรศัพท์\n3. แตะการบล็อกและระบุตัวตนสาย\n4. เปิดสวิตช์ NoSpam"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar, doğru sayfa değil, NoSpam'in kendi sayfasında açılacak. Oradan:\n\n1. Ayarların ana ekranına geri dönün (sol üstteki « ‹ Ayarlar »a dokunun)\n2. Telefon'a dokunun\n3. Çağrı Engelleme ve Tanımlama'ya dokunun\n4. NoSpam anahtarını açın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштування відкриються на власній сторінці NoSpam, а не на потрібній. Звідти:\n\n1. Поверніться на головний екран налаштувань (торкніться « ‹ Налаштування » у верхньому лівому куті)\n2. Торкніться Телефон\n3. Торкніться Блокування та ідентифікація викликів\n4. Увімкніть перемикач NoSpam"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سیٹنگز NoSpam کے اپنے صفحے پر کھلیں گی، درست صفحے پر نہیں۔ وہاں سے:\n\n1. سیٹنگز کی مین اسکرین پر واپس جائیں (اوپر «‹ سیٹنگز» پر ٹیپ کریں)\n2. فون پر ٹیپ کریں\n3. کال بلاکنگ اور شناخت پر ٹیپ کریں\n4. NoSpam سوئچ آن کریں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt sẽ mở trên trang riêng của NoSpam, không phải trang đúng. Từ đó:\n\n1. Quay lại màn hình chính của Cài đặt (chạm vào « ‹ Cài đặt » ở trên cùng bên trái)\n2. Chạm vào Điện thoại\n3. Chạm vào Chặn & Nhận dạng cuộc gọi\n4. Bật công tắc NoSpam"
          }
        }
      }
    },
