        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "NoSpam കമ്മ്യൂണിറ്റി നേരിട്ട് റിപ്പോർട്ട് ചെയ്ത നമ്പറുകൾ (വ്യത്യസ്ത ഉപയോക്താക്കളിൽ നിന്ന് കുറഞ്ഞത് 5 റിപ്പോർട്ടുകൾ)."
          }
