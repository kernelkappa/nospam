    "main.smsFilterHint" : {
      "localizations" : {
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Per filtrare anche gli SMS spam, abilita NoSpam da Impostazioni > Messaggi > Filtraggio SMS sconosciuti." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "To also filter spam SMS, enable NoSpam from Settings > Messages > Unknown & Spam." } },
