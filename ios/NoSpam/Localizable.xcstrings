    "Scegli la lingua dell'app dalle Impostazioni di sistema, indipendentemente da quella del telefono.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر لغة التطبيق من إعدادات النظام، بشكل مستقل عن لغة هاتفك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সিস্টেম সেটিংস থেকে অ্যাপের ভাষা বেছে নিন, ফোনের ভাষা থেকে স্বতন্ত্রভাবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria l'idioma de l'app des de la Configuració del sistema, independentment del del telèfon."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte jazyk aplikace v Nastavení systému, nezávisle na jazyku telefonu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg appens sprog fra systemindstillingerne, uafhængigt af telefonens."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die Sprache der App in den Systemeinstellungen, unabhängig von der deines Telefons."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε τη γλώσσα της εφαρμογής από τις ρυθμίσεις του συστήματος, ανεξάρτητα από αυτή του τηλεφώνου σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the app's language from system Settings, independently of your phone's."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige el idioma de la app desde los Ajustes del sistema, independientemente del de tu teléfono."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse sovelluksen kieli järjestelmän asetuksista, puhelimen kielestä riippumatta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la langue de l'application depuis les réglages système, indépendamment de celle du téléphone."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સિસ્ટમ સેટિંગ્સમાંથી એપની ભાષા પસંદ કરો, ફોનની ભાષાથી સ્વતંત્ર રીતે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר את שפת האפליקציה מהגדרות המערכת, ללא קשר לשפת הטלפון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम सेटिंग्स से ऐप की भाषा चुनें, फ़ोन की भाषा से स्वतंत्र।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite jezik aplikacije iz postavki sustava, nezavisno od jezika telefona."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassza ki az alkalmazás nyelvét a rendszerbeállításokból, a telefon nyelvétől függetlenül."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih bahasa aplikasi dari Pengaturan sistem, terlepas dari bahasa ponsel Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli la lingua dell'app dalle Impostazioni di sistema, indipendentemente da quella del telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定からアプリの言語を選択します。端末の言語には影響されません。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಿಸ್ಟಮ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳಿಂದ ಅಪ್ಲಿಕೇಶನ್‌ನ ಭಾಷೆಯನ್ನು ಆಯ್ಕೆಮಾಡಿ, ಫೋನ್‌ನ ಭಾಷೆಯಿಂದ ಸ್ವತಂತ್ರವಾಗಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정에서 앱의 언어를 선택하세요. 휴대폰 언어와는 관계없습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സിസ്റ്റം ക്രമീകരണങ്ങളിൽ നിന്ന് ആപ്പിന്റെ ഭാഷ തിരഞ്ഞെടുക്കുക, ഫോണിന്റെ ഭാഷയിൽ നിന്ന് സ്വതന്ത്രമായി."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम सेटिंग्जमधून अ‍ॅपची भाषा निवडा, फोनच्या भाषेपासून स्वतंत्रपणे."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih bahasa aplikasi daripada Tetapan sistem, tanpa mengira bahasa telefon anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg appens språk fra systeminnstillingene, uavhengig av telefonens."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies de taal van de app via de systeeminstellingen, onafhankelijk van die van je telefoon."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସିଷ୍ଟମ୍ ସେଟିଂସ୍‌ରୁ ଆପ୍‌ର ଭାଷା ଚୟନ କରନ୍ତୁ, ଫୋନ୍‌ର ଭାଷାରୁ ସ୍ୱତନ୍ତ୍ର ଭାବରେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਿਸਟਮ ਸੈਟਿੰਗਾਂ ਤੋਂ ਐਪ ਦੀ ਭਾਸ਼ਾ ਚੁਣੋ, ਫ਼ੋਨ ਦੀ ਭਾਸ਼ਾ ਤੋਂ ਸੁਤੰਤਰ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz język aplikacji w Ustawieniach systemowych, niezależnie od języka telefonu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o idioma da app nas Definições do sistema, independentemente do idioma do telefone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o idioma do app nas Configurações do sistema, independentemente do idioma do celular."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alegeți limba aplicației din Setările sistemului, independent de cea a telefonului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите язык приложения в системных настройках, независимо от языка телефона."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte jazyk aplikácie v Systémových nastaveniach, nezávisle od jazyka telefónu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberite jezik aplikacije v sistemskih nastavitvah, ne glede na jezik telefona."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj appens språk från systeminställningarna, oberoende av telefonens."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கணினி அமைப்புகளில் இருந்து பயன்பாட்டின் மொழியைத் தேர்ந்தெடுக்கவும், தொலைபேசியின் மொழியைப் பொருட்படுத்தாமல்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సిస్టమ్ సెట్టింగ్‌ల నుండి యాప్ భాషను ఎంచుకోండి, ఫోన్ భాషతో సంబంధం లేకుండా."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกภาษาของแอปจากการตั้งค่าระบบ โดยไม่ขึ้นกับภาษาของโทรศัพท์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamanın dilini telefonun dilinden bağımsız olarak Sistem Ayarları'ndan seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть мову програми в системних налаштуваннях, незалежно від мови телефону."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سسٹم سیٹنگز سے ایپ کی زبان منتخب کریں، فون کی زبان سے قطع نظر۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn ngôn ngữ của ứng dụng từ Cài đặt hệ thống, độc lập với ngôn ngữ của điện thoại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从系统设置中选择应用的语言，与手机语言无关。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從系統設定中選擇應用程式的語言，與手機語言無關。"
          }
        }
      }
    },
