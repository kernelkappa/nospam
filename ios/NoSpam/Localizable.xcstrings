        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডেটাবেস আপডেট হয়েছে। ব্লকিং সক্রিয় করতে, উপরে «সেটিংস খুলুন» ট্যাপ করুন এবং গাইড অনুসরণ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
