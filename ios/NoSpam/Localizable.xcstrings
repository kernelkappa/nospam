        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "NoSpam ಸಮುದಾಯವು ನೇರವಾಗಿ ವರದಿ ಮಾಡಿದ ಸಂಖ್ಯೆಗಳು (ಕನಿಷ್ಠ 5 ವಿಭಿನ್ನ ಬಳಕೆದಾರರಿಂದ ವರದಿಗಳು)."
