            "value": "استغرق الطلب وقتًا طويلاً: حاول مرة أخرى لاحقًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনুরোধে অনেক সময় লেগেছে: পরে আবার চেষ্টা করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La sol·licitud ha trigat massa: torna-ho a provar més tard."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Požadavek trval příliš dlouho: zkuste to znovu později."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmodningen tog for lang tid: prøv igen senere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anfrage hat zu lange gedauert: Bitte versuche es später erneut."
