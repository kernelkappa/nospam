    "onboarding.message" : {
      "localizations" : {
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Per bloccare automaticamente le chiamate spam, NoSpam deve essere abilitato da Impostazioni > Telefono > Blocco e identificazione chiamate. Ti guidiamo passo passo." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "To automatically block spam calls, NoSpam needs to be enabled from Settings > Phone > Call Blocking & Identification. We'll guide you step by step." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Para bloquear automáticamente las llamadas spam, NoSpam debe activarse desde Ajustes > Teléfono > Bloqueo e identificación de llamadas. Te guiamos paso a paso." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Pour bloquer automatiquement les appels indésirables, NoSpam doit être activé depuis Réglages > Téléphone > Blocage et identification des appels. Nous vous guidons étape par étape." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Um Spam-Anrufe automatisch zu blockieren, muss NoSpam unter Einstellungen > Telefon > Anrufe blockieren & identifizieren aktiviert werden. Wir führen dich Schritt für Schritt." } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "Para bloquear automaticamente chamadas spam, o NoSpam deve ser ativado em Definições > Telefone > Bloqueio e identificação de chamadas. Guiamo-lo passo a passo." } }
      }
    },
    "settingsGuide.message" : {
      "localizations" : {
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Impostazioni si aprirà sulla pagina di NoSpam, non su quella giusta. Da lì:\n\n1. Torna alla schermata principale di Impostazioni (tocca « ‹ Impostazioni » in alto a sinistra)\n2. Tocca Telefono\n3. Tocca Blocco e identificazione chiamate\n4. Attiva l'interruttore NoSpam" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Settings will open on NoSpam's own page, not the right one. From there:\n\n1. Go back to the main Settings screen (tap « ‹ Settings » at the top left)\n2. Tap Phone\n3. Tap Call Blocking & Identification\n4. Turn on the NoSpam switch" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Ajustes se abrirá en la página de NoSpam, no en la correcta. Desde allí:\n\n1. Vuelve a la pantalla principal de Ajustes (toca « ‹ Ajustes » arriba a la izquierda)\n2. Toca Teléfono\n3. Toca Bloqueo e identificación de llamadas\n4. Activa el interruptor de NoSpam" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Réglages s'ouvrira sur la page de NoSpam, pas la bonne. À partir de là :\n\n1. Revenez à l'écran principal de Réglages (appuyez sur « ‹ Réglages » en haut à gauche)\n2. Appuyez sur Téléphone\n3. Appuyez sur Blocage et identification des appels\n4. Activez l'interrupteur NoSpam" } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Einstellungen öffnet sich auf der Seite von NoSpam, nicht auf der richtigen. Von dort aus:\n\n1. Gehe zurück zum Hauptbildschirm der Einstellungen (tippe oben links auf „‹ Einstellungen“)\n2. Tippe auf Telefon\n3. Tippe auf Anrufe blockieren & identifizieren\n4. Aktiviere den NoSpam-Schalter" } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "As Definições abrirão na página do NoSpam, não na correta. A partir daí:\n\n1. Volte ao ecrã principal das Definições (toque em «‹ Definições» no canto superior esquerdo)\n2. Toque em Telefone\n3. Toque em Bloqueio e identificação de chamadas\n4. Ative o interruptor do NoSpam" } }
      }
    },
